{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waje.dev/schemas/evals/gate3/review-package.v1.schema.json",
  "title": "WAJE Gate 3 Independent Review Package Batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "package_version",
    "status",
    "packages"
  ],
  "properties": {
    "package_version": {
      "const": "gate3.review-package.v1"
    },
    "status": {
      "const": "awaiting_independent_review"
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/reviewPackage"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reviewPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_id",
        "episode_id",
        "episode_core_sha256",
        "authoring_episode_ref",
          "source_record_ref",
          "suite_binding",
          "data_source_bindings",
          "evaluation_clock",
        "agent_world_view_sha256",
        "evaluator_oracle_view_sha256",
        "business_review_scopes",
        "measurement_review_scopes",
        "open_machine_findings",
        "required_independent_roles"
      ],
      "properties": {
        "package_id": {
          "type": "string",
          "pattern": "^REVIEW-PACKAGE-[A-Z0-9-]+$"
        },
        "episode_id": {
          "type": "string",
          "pattern": "^G3-[A-Z]+-[0-9]{3}$"
        },
        "episode_core_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "authoring_episode_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_record_ref": {
          "type": "string",
          "pattern": "^SRC-[A-Z0-9-]+$"
        },
        "suite_binding": {
          "type": "object",
          "required": [
            "business_domain",
            "coverage_group",
            "factor_group_refs",
            "question_family_refs"
          ]
        },
        "data_source_bindings": {
          "type": "array",
          "minItems": 1
        },
        "evaluation_clock": {
          "type": "object"
        },
        "agent_world_view_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "evaluator_oracle_view_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "business_review_scopes": {
          "$ref": "#/$defs/stringArray"
        },
        "measurement_review_scopes": {
          "$ref": "#/$defs/stringArray"
        },
        "open_machine_findings": {
          "$ref": "#/$defs/stringArray"
        },
        "required_independent_roles": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "business_owner",
              "measurement_reviewer"
            ]
          }
        }
      }
    }
  }
}
