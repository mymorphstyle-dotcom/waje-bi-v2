{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waje.dev/schemas/evals/gate3/gate3-admission-envelope.v1.schema.json",
  "title": "WAJE Gate 3 Protected CI Admission",
  "oneOf": [
    {
      "$ref": "#/$defs/protectedCITrustPolicy"
    },
    {
      "$ref": "#/$defs/protectedCIContext"
    },
    {
      "$ref": "#/$defs/admissionEnvelope"
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "protectedCITrustPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "artifact_version",
        "trust_policy_id",
        "trust_policy_epoch",
        "trust_domain",
        "audience",
        "repository_id",
        "issuer_id",
        "key_id",
        "algorithm",
        "public_key_base64",
        "key_valid_from",
        "key_valid_until",
        "workflow_ref",
        "workflow_revision_sha256",
        "runner_release_sha256",
        "allowed_protected_refs",
        "maximum_validity_seconds"
      ],
      "properties": {
        "artifact_type": {
          "const": "gate3_protected_ci_trust_policy"
        },
        "artifact_version": {
          "const": "gate3.protected-ci-trust-policy.v1"
        },
        "trust_policy_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "trust_policy_epoch": {
          "type": "integer",
          "minimum": 1
        },
        "trust_domain": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "audience": {
          "const": "waje-gate3-e0"
        },
        "repository_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "issuer_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "key_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "algorithm": {
          "const": "ed25519"
        },
        "public_key_base64": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{43}=$"
        },
        "key_valid_from": {
          "type": "string",
          "format": "date-time"
        },
        "key_valid_until": {
          "type": "string",
          "format": "date-time"
        },
        "workflow_ref": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "workflow_revision_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "runner_release_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "allowed_protected_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "maximum_validity_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      }
    },
    "protectedCIContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "artifact_version",
        "repository_id",
        "source_revision",
        "protected_ref",
        "workflow_ref",
        "workflow_revision_sha256",
        "runner_release_sha256",
        "run_id",
        "run_attempt"
      ],
      "properties": {
        "artifact_type": {
          "const": "gate3_protected_ci_context"
        },
        "artifact_version": {
          "const": "gate3.protected-ci-context.v1"
        },
        "repository_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        },
        "protected_ref": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "workflow_ref": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "workflow_revision_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "runner_release_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "run_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "run_attempt": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "admissionEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "artifact_version",
        "payload",
        "signature"
      ],
      "properties": {
        "artifact_type": {
          "const": "gate3_external_admission_envelope"
        },
        "artifact_version": {
          "const": "gate3.external-admission.v1"
        },
        "payload": {
          "$ref": "#/$defs/admissionPayload"
        },
        "signature": {
          "$ref": "#/$defs/signature"
        }
      }
    },
    "admissionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trust_domain",
        "audience",
        "issuer_id",
        "key_id",
        "repository_id",
        "source_revision",
        "protected_ref",
        "workflow_ref",
        "workflow_revision_sha256",
        "runner_release_sha256",
        "run_id",
        "run_attempt",
        "issued_at",
        "expires_at",
        "trust_policy_sha256",
        "policy_sha256",
        "authority_root_bundle_sha256",
        "verifier_release_sha256",
        "evaluated_artifact_hashes",
        "authorized_attestation_sha256s",
        "authorized_manifest_sha256s"
      ],
      "properties": {
        "trust_domain": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "audience": {
          "const": "waje-gate3-e0"
        },
        "issuer_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "key_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "repository_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        },
        "protected_ref": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "workflow_ref": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "workflow_revision_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "runner_release_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "run_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "run_attempt": {
          "type": "integer",
          "minimum": 1
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "trust_policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "authority_root_bundle_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "verifier_release_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "evaluated_artifact_hashes": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9._/-]+$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/sha256"
          }
        },
        "authorized_attestation_sha256s": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "authorized_manifest_sha256s": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "value_base64"
      ],
      "properties": {
        "algorithm": {
          "const": "ed25519"
        },
        "key_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "value_base64": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      }
    }
  }
}
