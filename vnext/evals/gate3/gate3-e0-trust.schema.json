      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_cell_id",
        "episode_id",
        "episode_core_sha256",
        "world_profile_ref",
        "world_profile_sha256",
        "authority_profile_ref",
        "authority_profile_sha256",
        "product_grader_profile_ref",
        "case_variant"
      ],
      "properties": {
        "run_cell_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "episode_id": {
          "type": "string",
          "pattern": "^G3-[A-Z]+-[0-9]{3}$"
        },
        "episode_core_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "world_profile_ref": {
          "$ref": "#/$defs/id"
        },
