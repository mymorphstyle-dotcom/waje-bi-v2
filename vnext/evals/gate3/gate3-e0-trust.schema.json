{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waje.dev/schemas/evals/gate3/gate3-e0-trust.v1.schema.json",
  "title": "WAJE Gate 3 E0 Trust Artifacts",
  "oneOf": [
    {
      "$ref": "#/$defs/coverageTaxonomy"
    },
    {
      "$ref": "#/$defs/sourceRegistry"
    },
    {
      "$ref": "#/$defs/reviewRegistry"
    },
    {
      "$ref": "#/$defs/corpusRegistry"
    },
    {
      "$ref": "#/$defs/graderRegistry"
    },
    {
      "$ref": "#/$defs/authorityProfiles"
    },
    {
      "$ref": "#/$defs/worldProfiles"
    },
    {
      "$ref": "#/$defs/promotionManifest"
    },
    {
      "$ref": "#/$defs/heldOutManifest"
    },
    {
      "$ref": "#/$defs/heldOutPromotionReceipt"
    },
    {
      "$ref": "#/$defs/calibrationPackage"
    },
    {
      "$ref": "#/$defs/runManifest"
    },
    {
      "$ref": "#/$defs/readinessManifest"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    },
    "artifactHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "artifact_version",
        "registry_epoch"
      ],
      "properties": {
        "artifact_type": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "artifact_version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "registry_epoch": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "coverageTaxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "artifact_version",
        "registry_epoch",
        "dimensions"
      ],
      "properties": {
        "artifact_type": {
          "const": "coverage_taxonomy"
        },
        "artifact_version": {
          "const": "gate3.coverage-taxonomy.v1"
        },
        "registry_epoch": {
          "type": "integer",
          "minimum": 1
        },
        "dimensions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        }
      }
    },
    "sourceRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "artifact_version",
        "registry_epoch",
        "records"
      ],
      "properties": {
        "artifact_type": {
          "const": "source_registry"
        },
        "artifact_version": {
          "const": "gate3.source-registry.v1"
        },
        "registry_epoch": {
          "type": "integer",
          "minimum": 1
        },
        "records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceRecord"
          }
        }
      }
    },
    "sourceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_record_id",
        "source_pool",
        "provenance_kind",
        "verification_status",
        "source_artifacts",
        "attested_scope",
        "independent_source_key"
      ],
      "properties": {
        "source_record_id": {
          "type": "string",
          "pattern": "^SRC-[A-Z0-9-]+$"
        },
        "source_pool": {
          "enum": [
            "real_user_language",
            "expert_business_case",
            "historical_failure",
            "generated_business_world",
            "adversarial_conversation"
          ]
        },
        "provenance_kind": {
          "enum": [
            "task_transcript",
            "expert_authorship",
            "incident_reconstruction",
            "controlled_generation",
            "adversarial_generation"
          ]
        },
        "verification_status": {
          "enum": [
            "verified",
            "pending_external_evidence",
            "revoked"
          ]
        },
        "source_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref",
              "content_sha256"
            ],
            "properties": {
              "ref": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "content_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        "attested_scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "user_wording",
              "business_world",
              "historical_failure_identity",
              "authoring_method"
            ]
          }
        },
        "independent_source_key": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "privacy_status": {
          "enum": [
            "approved_redacted",
            "pending_review",
            "not_applicable"
          ]
        },
        "verification_authority_ref": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "reviewRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "artifact_version",
        "registry_epoch",
        "principals",
        "records",
        "calibration_records"
      ],
      "properties": {
        "artifact_type": {
          "const": "review_registry"
        },
        "artifact_version": {
          "const": "gate3.review-registry.v2"
        },
        "registry_epoch": {
          "type": "integer",
          "minimum": 1
        },
        "principals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reviewerPrincipal"
          }
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reviewRecord"
          }
        },
        "calibration_records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/calibrationReviewRecord"
          }
        }
      }
    },
    "reviewerPrincipal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_id",
        "roles",
        "status",
        "authority_root_ref"
      ],
      "properties": {
        "principal_id": {
          "type": "string",
          "pattern": "^REVIEWER-[A-Z0-9-]+$"
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "business_owner",
              "measurement_reviewer",
              "calibration_reviewer"
            ]
          }
        },
        "status": {
          "enum": [
            "active",
            "revoked"
          ]
        },
        "authority_root_ref": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "reviewRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_record_id",
        "episode_id",
        "episode_core_sha256",
        "principal_id",
        "reviewer_role",
        "decision",
        "reviewed_scopes",
        "review_package_sha256"
      ],
      "properties": {
        "review_record_id": {
          "type": "string",
          "pattern": "^REVIEW-[A-Z0-9-]+$"
        },
        "episode_id": {
          "type": "string",
          "pattern": "^G3-[A-Z]+-[0-9]{3}$"
        },
        "episode_core_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "principal_id": {
          "type": "string",
          "pattern": "^REVIEWER-[A-Z0-9-]+$"
        },
        "reviewer_role": {
          "enum": [
            "business_owner",
            "measurement_reviewer"
          ]
        },
        "decision": {
          "enum": [
            "approved",
            "changes_requested",
            "rejected"
          ]
        },
        "reviewed_scopes": {
          "$ref": "#/$defs/stringArray"
        },
        "review_package_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "calibrationReviewRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calibration_review_record_id",
        "episode_id",
        "episode_core_sha256",
        "principal_id",
        "run_cell_id",
        "case_variant",
        "evaluator_profile_ref",
        "evaluator_profile_sha256",
        "grader_result_sha256",
        "human_verdict"
      ],
      "properties": {
        "calibration_review_record_id": {
          "type": "string",
          "pattern": "^CAL-REVIEW-[A-Z0-9-]+$"
        },
        "episode_id": {
          "type": "string",
          "pattern": "^G3-[A-Z]+-[0-9]{3}$"
        },
        "episode_core_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "principal_id": {
          "type": "string",
          "pattern": "^REVIEWER-[A-Z0-9-]+$"
        },
        "run_cell_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "case_variant": {
          "$ref": "#/$defs/runCaseVariant"
        },
        "evaluator_profile_ref": {
          "$ref": "#/$defs/id"
        },
        "evaluator_profile_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "grader_result_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "human_verdict": {
          "enum": [
            "pass",
            "fail",
            "blocked",
            "invalid"
          ]
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "corpusRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "artifact_version",
        "registry_epoch",
        "entries"
      ],
      "properties": {
        "artifact_type": {
          "const": "corpus_registry"
        },
        "artifact_version": {
          "const": "gate3.corpus-registry.v2"
        },
        "registry_epoch": {
          "type": "integer",
          "minimum": 1
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/corpusEntry"
          }
        }
      }
    },
    "corpusEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episode_id",
        "episode_core_sha256",
        "source_record_ref",
        "authoring_batch_id",
        "business_world_independence_key",
        "claim_target_kinds",
        "coverage_tags",
        "product_grader_profile_ref",
        "authority_profile_ref",
        "world_profile_ref"
      ],
      "properties": {
        "episode_id": {
          "type": "string",
          "pattern": "^G3-[A-Z]+-[0-9]{3}$"
        },
        "episode_core_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_record_ref": {
          "type": "string",
          "pattern": "^SRC-[A-Z0-9-]+$"
        },
        "authoring_batch_id": {
          "type": "string",
          "pattern": "^BATCH-[A-Z0-9-]+$"
        },
        "business_world_independence_key": {
          "type": "string",
          "pattern": "^authority-set:[a-f0-9]{64}$"
        },
        "claim_target_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "definition",
              "data_quality_state",
              "point_quantity",
              "distribution",
              "temporal_pattern",
              "contrast",
              "composition",
              "accounting_decomposition",
              "cohort_outcome",
              "funnel_transition",
              "association",
              "causal_effect",
              "diagnostic_set"
            ]
          }
        },
        "coverage_tags": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/stringArray"
          }
        },
        "product_grader_profile_ref": {
          "$ref": "#/$defs/id"
        },
        "authority_profile_ref": {
          "$ref": "#/$defs/id"
        },
        "world_profile_ref": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "graderRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "artifact_version",
        "registry_epoch",
        "profiles",
        "evaluator_profiles",
        "predicates",
        "authority_invariants",
        "implementation_checks"
      ],
      "properties": {
        "artifact_type": {
          "const": "grader_registry"
        },
        "artifact_version": {
          "const": "gate3.grader-registry.v2"
        },
        "registry_epoch": {
          "type": "integer",
          "minimum": 1
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/graderProfile"
          }
        },
        "evaluator_profiles": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/evaluatorProfile"
          }
        },
        "predicates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/graderPredicate"
          }
        },
        "authority_invariants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/authorityInvariant"
          }
        },
        "implementation_checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/implementationCheck"
          }
        }
      }
    },
    "graderProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "layer",
        "required_predicate_ids"
      ],
      "properties": {
        "profile_id": {
          "$ref": "#/$defs/id"
        },
        "layer": {
          "enum": [
            "product_behavior",
            "authority_conformance",
            "implementation"
          ]
        },
        "required_predicate_ids": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "evaluatorProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "role",
        "provider",
        "model",
        "thinking",
        "lifecycle_status",
        "prompt_bundle_ref",
        "prompt_contract_id",
        "prompt_sha256",
        "rubric_ref",
        "rubric_sha256",
        "input_contract_sha256",
        "output_contract_sha256",
        "runner_ref",
        "runner_sha256"
      ],
      "properties": {
        "profile_id": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "enum": [
            "primary_business_analysis_agent",
            "runtime_reviewer",
            "evaluation_reviewer"
          ]
        },
        "provider": {
          "const": "deepseek"
        },
        "model": {
          "enum": [
            "deepseek-v4-flash",
            "deepseek-v4-pro"
          ]
        },
        "thinking": {
          "enum": [
            "enabled",
            "disabled"
          ]
        },
        "lifecycle_status": {
          "enum": [
            "quality_probe_only",
            "selected_unprovisioned",
            "calibration_eligible",
            "revoked"
          ]
        },
        "prompt_bundle_ref": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "prompt_contract_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]+$"
        },
        "prompt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "rubric_ref": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "rubric_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "input_contract_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "output_contract_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "runner_ref": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "runner_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "graderPredicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predicate_id",
        "layer",
        "evaluator_types",
        "required_input_views",
        "unassessable_disposition",
        "severity"
      ],
      "properties": {
        "predicate_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]+$"
        },
        "layer": {
          "const": "product_behavior"
        },
        "evaluator_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "deterministic",
              "model",
              "human"
            ]
          }
        },
        "required_input_views": {
          "$ref": "#/$defs/stringArray"
        },
        "unassessable_disposition": {
          "const": "blocked"
        },
        "severity": {
          "enum": [
            "blocking",
            "major"
          ]
        }
      }
    },
    "authorityInvariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invariant_id",
        "required_observation_kinds",
        "severity"
      ],
      "properties": {
        "invariant_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]+$"
        },
        "required_observation_kinds": {
          "$ref": "#/$defs/stringArray"
        },
        "severity": {
          "const": "blocking"
        }
      }
    },
    "implementationCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "severity"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]+$"
        },
        "severity": {
          "const": "blocking"
        }
      }
    },
    "authorityProfiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "artifact_version",
        "registry_epoch",
        "profiles",
        "bindings"
      ],
      "properties": {
        "artifact_type": {
          "const": "authority_conformance_profiles"
        },
        "artifact_version": {
          "const": "gate3.authority-conformance.v1"
        },
        "registry_epoch": {
          "type": "integer",
          "minimum": 1
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "profile_id",
              "authority_contract_version",
              "required_invariant_ids",
              "trace_profile_ref"
            ],
            "properties": {
              "profile_id": {
                "$ref": "#/$defs/id"
              },
              "authority_contract_version": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "required_invariant_ids": {
                "$ref": "#/$defs/stringArray"
              },
              "trace_profile_ref": {
                "$ref": "#/$defs/id"
              }
            }
          }
        },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "episode_id",
              "episode_core_sha256",
              "world_profile_ref",
              "profile_id"
            ],
            "properties": {
              "episode_id": {
                "type": "string",
                "pattern": "^G3-[A-Z]+-[0-9]{3}$"
              },
              "episode_core_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "world_profile_ref": {
                "$ref": "#/$defs/id"
              },
              "profile_id": {
                "$ref": "#/$defs/id"
              }
            }
          }
        }
      }
    },
    "worldProfiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "artifact_version",
        "registry_epoch",
        "profiles"
      ],
      "properties": {
        "artifact_type": {
          "const": "cross_gate_world_profiles"
        },
        "artifact_version": {
          "const": "gate3.cross-gate-world-profiles.v1"
        },
        "registry_epoch": {
          "type": "integer",
          "minimum": 1
        },
        "profiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/worldProfile"
          }
        }
      }
    },
    "worldProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "episode_id",
        "episode_core_sha256",
        "world_id",
        "business_world_independence_key",
        "stage_profiles"
      ],
      "properties": {
        "profile_id": {
          "$ref": "#/$defs/id"
        },
        "episode_id": {
          "type": "string",
          "pattern": "^G3-[A-Z]+-[0-9]{3}$"
        },
        "episode_core_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "world_id": {
          "$ref": "#/$defs/id"
        },
        "business_world_independence_key": {
          "type": "string",
          "pattern": "^authority-set:[a-f0-9]{64}$"
        },
        "stage_profiles": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gate3",
            "gate4",
            "gate5",
            "gate6",
            "gate7"
          ],
          "properties": {
            "gate3": {
              "$ref": "#/$defs/profileStage"
            },
            "gate4": {
              "$ref": "#/$defs/profileStage"
            },
            "gate5": {
              "$ref": "#/$defs/profileStage"
            },
            "gate6": {
              "$ref": "#/$defs/profileStage"
            },
            "gate7": {
              "$ref": "#/$defs/profileStage"
            }
          }
        }
      }
    },
    "profileStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "required_artifacts"
      ],
      "properties": {
        "status": {
          "enum": [
            "authoring",
            "pending",
            "reviewed"
          ]
        },
        "required_artifacts": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "promotionManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
