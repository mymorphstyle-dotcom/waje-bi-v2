          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/sha256"
          }
        },
        "run_cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/runCell"
          }
        },
        "required_layers": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "product_behavior",
              "authority_conformance",
              "implementation"
            ]
          }
        },
        "authority_root_ref": {
          "$ref": "#/$defs/id"
        },
        "authority_history": {
          "$ref": "#/$defs/authorityHistory"
        }
      }
    },
