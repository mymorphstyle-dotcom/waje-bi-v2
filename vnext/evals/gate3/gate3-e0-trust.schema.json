          "$ref": "#/$defs/sha256"
        },
        "authority_profile_ref": {
          "$ref": "#/$defs/id"
        },
        "authority_profile_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "product_grader_profile_ref": {
          "$ref": "#/$defs/id"
        },
        "case_variant": {
          "$ref": "#/$defs/runCaseVariant"
        }
      }
    },
    "runCaseVariant": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "base"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "sibling_id",
            "materialized_sibling_sha256"
          ],
          "properties": {
            "kind": {
              "const": "counterfactual"
            },
            "sibling_id": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "materialized_sibling_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      ]
