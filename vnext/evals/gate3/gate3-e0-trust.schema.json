    "authorityHistory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predecessor_ref",
        "predecessor_sha256"
      ],
      "properties": {
        "predecessor_ref": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "predecessor_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "readinessManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "artifact_version",
        "registry_epoch",
        "evaluated_artifact_hashes",
        "condition_verdicts",
        "derived_status",
        "entry_decision"
      ],
      "properties": {
        "artifact_type": {
          "const": "readiness_manifest"
        },
        "artifact_version": {
          "const": "gate3.e0-readiness.v2"
        },
        "registry_epoch": {
          "type": "integer",
          "minimum": 1
        },
        "evaluated_artifact_hashes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/sha256"
          }
        },
        "condition_verdicts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "condition_id",
              "verdict",
              "evidence"
            ],
            "properties": {
              "condition_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]+$"
              },
              "verdict": {
                "enum": [
                  "pass",
                  "blocked"
                ]
              },
              "evidence": {
                "$ref": "#/$defs/stringArray"
              }
            }
          }
        },
        "derived_status": {
          "enum": [
            "ready",
            "blocked"
          ]
        },
        "entry_decision": {
          "enum": [
            "allow_g3_1",
            "deny_g3_1"
          ]
        }
      }
    }
  }
}
