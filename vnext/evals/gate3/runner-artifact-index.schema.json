{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waje.dev/schemas/evals/gate3/runner-artifact-index.v1.schema.json",
  "title": "WAJE Gate 3 Runner Artifact Index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "artifact_version",
    "run_manifest_sha256",
    "run_cells"
  ],
  "properties": {
    "artifact_type": {
      "const": "runner_artifact_index"
    },
    "artifact_version": {
      "const": "gate3.runner-artifact-index.v1"
    },
    "run_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "run_cells": {
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/runCellArtifacts"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sha256Array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sha256"
      }
    },
    "runCellArtifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_behavior",
        "authority_conformance",
        "implementation"
      ],
      "properties": {
        "product_behavior": {
          "$ref": "#/$defs/sha256Array"
        },
        "authority_conformance": {
          "$ref": "#/$defs/sha256Array"
        },
        "implementation": {
          "$ref": "#/$defs/sha256Array"
        }
      }
    }
  }
}
