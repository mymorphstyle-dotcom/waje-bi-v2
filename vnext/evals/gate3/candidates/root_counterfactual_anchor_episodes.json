        "truth_facts": [
          {
            "truth_id": "TRUTH-G3-ROOT-001-01",
            "statement": "奖金核算需要稳定、可审计且难被短期行为操纵的客户法人或合同主体口径。",
            "observability": "evaluator_only",
            "identifiability": "pending_independent_review"
          },
          {
            "truth_id": "TRUTH-G3-ROOT-001-02",
            "statement": "产品采用需要 workspace 行为口径，无法与奖金口径共享同一个分子和观察单位。",
            "observability": "evaluator_only",
            "identifiability": "pending_independent_review"
          },
          {
            "truth_id": "TRUTH-G3-ROOT-001-03",
            "statement": "统一语义层可以维护一个概念族和明确用途，强行生成单一万能数字会损害至少一个决策。",
            "observability": "evaluator_only",
            "identifiability": "pending_independent_review"
          },
          {
            "truth_id": "TRUTH-G3-ROOT-001-04",
            "statement": "合作伙伴渠道在实体映射补齐前只能给出边界或分渠道口径。",
            "observability": "evaluator_only",
            "identifiability": "pending_independent_review"
          }
        ]
      },
      "decision_stakes": {
        "business_decision": "确定销售奖金、经营看板和产品采用分析如何使用活跃企业客户概念。",
        "consequence_of_error": "错误合并观察单位会改变奖金、夸大或压低客户规模，并让跨团队指标无法审计。",
        "risk_level": "high"
      },
      "acceptable_outcome": {
        "must_preserve": [
          "用户要解决的是跨用途指标治理和可复用边界。",
          "account、workspace、合同、付款主体和客户法人是不同观察单位。",
          "统一可以表现为有明确用途的定义族，无需承诺一个数字适合所有决策。"
        ],
        "valid_design_space": [
          {
            "design_family": "purpose_bound_metric_family",
            "rationale": "为奖金、经营规模和产品采用分别定义成员资格、观察单位与去重规则，再给出允许汇总的共同概念层。",
            "required_properties": [
              "每个用途声明观察单位、成员资格、分子、分母或适用的无分母定义。",
              "明确多对多实体映射及无法映射的渠道边界。",
              "同名指标之间禁止直接数值替换。"
            ]
          },
          {
            "design_family": "governed_primary_definition_with_named_satellites",
            "rationale": "选择一个公司级主定义用于经营规模，同时保留销售资格和产品采用两个有命名的卫星指标。",
            "required_properties": [
              "主定义的决策用途和 claim ceiling 明确。",
              "卫星指标不能被标记成主定义的可互换实现。",
              "奖金规则经过业务 owner 明确接受。"
            ]
          }
        ],
        "must_investigate": [
          "三个合同各自的决策用途、观察单位、成员资格、去重和排除规则。",
          "account、workspace、合同、付款主体与客户法人的映射覆盖率和多对多关系。",
          "奖金是否允许续约宽限期、试用、零收入合同和合作伙伴渠道。",
          "统一定义是否会改变已承诺的薪酬或财务治理边界。"
        ],
        "allowed_dispositions": [
          "executable_design",
          "clarification_required",
          "typed_boundary"
        ],
        "allowed_boundary_codes": [
          "conflicting_contract",
          "missing_contract",
          "unsupported_grain"
        ],
        "claim_ceiling": "definition_only",
        "clarification_policy": {
          "mode": "ask_only_if_material_and_undiscoverable",
          "rationale": "先检查正式合同和实体映射；只有奖金用途的 owner 选择仍会实质改变成员资格且无法从治理资料确定时，才提出一个带推荐项的问题。"
        }
      },
      "forbidden_outcomes": [
        {
          "failure_code": "universal_metric_without_use_boundary",
          "description": "把任一团队现有数字直接宣布为所有用途的统一指标。",
          "severity": "blocking"
        },
        {
          "failure_code": "observation_unit_collapse",
          "description": "把 workspace、account、合同或客户法人当作可互换观察单位。",
          "severity": "blocking"
        },
        {
          "failure_code": "ask_before_inspecting_contracts",
          "description": "把合同和映射中可查明的事实交给用户重新定义。",
          "severity": "major"
        },
        {
          "failure_code": "compensation_scope_overreach",
          "description": "在缺少奖金 owner 决策时给出会改变薪酬资格的强制定义。",
          "severity": "blocking"
        }
      ],
