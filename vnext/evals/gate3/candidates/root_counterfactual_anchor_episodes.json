      "user_episode": {
        "locale": "zh-CN",
        "messages": [
          {
            "turn": 1,
            "speaker": "user",
            "text": "销售奖金和经营看板都要用“活跃企业客户”，但销售、产品、财务现在各算各的。请帮我给出一个能落地的统一定义，并说明哪些场景不能共用。",
            "communication_function": "question",
            "trigger": {
              "kind": "initial",
              "fallback": "none"
            }
          }
        ]
      },
      "business_world": {
        "world_id": "WORLD-ACTIVE-ENTERPRISE-DEFINITION",
        "narrative": "一家按席位订阅并叠加用量收费的 SaaS 公司准备统一经营指标。销售关注有有效合同的账户，产品关注发生关键行为的 workspace，财务关注存在当期可确认收入的客户法人。一个法人可能拥有多个合同、workspace 和付款主体。",
        "available_contracts": [
          {
            "contract_ref": "metric.sales.active_account.v3",
            "state": "available",
            "description": "销售定义按 account 去重，要求有效合同或处于正式续约宽限期。",
            "discoverability": "discoverable_by_semantic_inspection",
            "access_state": "accessible"
          },
          {
            "contract_ref": "metric.product.active_workspace.v5",
            "state": "available",
            "description": "产品定义按 workspace 去重，要求完成一项关键协作行为。",
            "discoverability": "discoverable_by_semantic_inspection",
            "access_state": "accessible"
          },
          {
            "contract_ref": "metric.finance.revenue_customer.v2",
            "state": "available",
            "description": "财务定义按 customer legal entity 去重，要求存在可确认收入。",
            "discoverability": "discoverable_by_semantic_inspection",
            "access_state": "accessible"
          },
          {
            "contract_ref": "entity.enterprise_customer_mapping",
            "state": "partial",
            "description": "account、workspace、合同、付款主体和法人之间的多对多映射只覆盖直接销售渠道。",
            "discoverability": "discoverable_by_semantic_inspection",
            "access_state": "accessible"
          }
        ],
        "data_conditions": [
          {
            "condition_id": "DC-ACTIVE-CUSTOMER-GRAIN-CONFLICT",
            "description": "三个正式定义使用不同观察单位，数值无法直接等同。",
            "discoverability": "discoverable_by_semantic_inspection",
            "materiality": "critical"
          },
          {
            "condition_id": "DC-ACTIVE-CUSTOMER-MAPPING-GAP",
            "description": "合作伙伴渠道缺少 workspace 到客户法人的可靠映射。",
            "discoverability": "discoverable_by_data_probe",
            "materiality": "material"
          }
        ],
        "evaluation_clock": {
          "as_of_instant": "2026-07-30T09:00:00+08:00",
