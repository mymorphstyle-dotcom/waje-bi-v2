{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waje.dev/schemas/evals/gate3/evaluation-episode.v2.schema.json",
  "title": "WAJE Gate 3 Behavior Evaluation Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalog_version",
    "episodes"
  ],
  "properties": {
    "catalog_version": {
      "const": "gate3.behavior-eval.v2"
    },
    "episodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evaluationEpisode"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    },
    "evaluationEpisode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episode_id",
        "title",
        "source_pool",
        "provenance",
        "user_episode",
        "business_world",
        "decision_stakes",
        "support_expectation",
        "acceptable_outcome",
        "forbidden_outcomes",
        "counterfactual_siblings",
        "coverage_tags"
      ],
      "properties": {
        "episode_id": {
          "type": "string",
          "pattern": "^G3-[A-Z]+-[0-9]{3}$"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source_pool": {
          "enum": [
            "real_user_language",
            "expert_business_case",
            "historical_failure",
            "generated_business_world",
            "adversarial_conversation"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "user_episode": {
          "$ref": "#/$defs/userEpisode"
        },
        "business_world": {
          "$ref": "#/$defs/businessWorld"
        },
        "decision_stakes": {
          "$ref": "#/$defs/decisionStakes"
        },
        "support_expectation": {
          "$ref": "#/$defs/supportExpectation"
        },
        "acceptable_outcome": {
          "$ref": "#/$defs/acceptableOutcome"
        },
        "forbidden_outcomes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/forbiddenOutcome"
          }
        },
        "counterfactual_siblings": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/counterfactualSibling"
          }
        },
        "coverage_tags": {
          "$ref": "#/$defs/coverageTags"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authoring_method",
        "origin_note",
        "source_record_ref",
        "authoring_batch_id"
      ],
      "properties": {
        "authoring_method": {
          "enum": [
            "domain_interview",
            "expert_authored",
            "historical_failure_reconstruction",
            "controlled_world_generation",
            "adversarial_authoring",
            "redacted_production_trace"
          ]
        },
        "origin_note": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source_record_ref": {
          "type": "string",
          "pattern": "^SRC-[A-Z0-9-]+$"
        },
        "authoring_batch_id": {
          "type": "string",
          "pattern": "^BATCH-[A-Z0-9-]+$"
        }
      }
    },
    "userEpisode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locale",
        "messages"
      ],
      "properties": {
        "locale": {
          "type": "string",
          "minLength": 2
        },
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/userMessage"
          }
        }
      }
    },
    "userMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turn",
        "speaker",
        "trigger",
        "text"
      ],
      "properties": {
        "turn": {
          "type": "integer",
          "minimum": 1
        },
        "speaker": {
          "const": "user"
        },
        "trigger": {
          "$ref": "#/$defs/messageTrigger"
        },
        "text": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "communication_function": {
          "enum": [
            "question",
            "context",
            "correction",
            "constraint",
            "challenge",
            "scope_revision",
            "request_for_explanation"
          ]
        }
      }
    },
    "messageTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "fallback"
      ],
      "properties": {
        "kind": {
          "enum": [
            "initial",
            "after_agent_clarification",
            "after_user_visible_measurement_proposal",
            "while_investigation_pending",
            "after_user_visible_provisional_answer"
          ]
        },
        "fallback": {
          "enum": [
            "none",
            "inject_when_observable_or_mark_unreached"
          ]
        }
      }
    },
    "businessWorld": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "world_id",
        "narrative",
        "evaluation_clock",
        "available_contracts",
        "data_conditions",
        "truth_facts"
      ],
      "properties": {
        "world_id": {
          "type": "string",
          "pattern": "^WORLD-[A-Z0-9-]+$"
        },
        "narrative": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evaluation_clock": {
          "$ref": "#/$defs/evaluationClock"
        },
        "available_contracts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/worldContract"
          }
        },
        "data_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/dataCondition"
          }
        },
        "truth_facts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/truthFact"
          }
        }
      }
    },
    "truthFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "truth_id",
        "statement",
        "observability",
        "identifiability"
      ],
      "properties": {
        "truth_id": {
          "type": "string",
          "pattern": "^TRUTH-[A-Z0-9-]+$"
        },
        "statement": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "observability": {
          "enum": [
            "agent_observable",
            "evaluator_only"
          ]
        },
        "identifiability": {
          "enum": [
            "identifiable_from_world",
            "latent_unidentifiable",
            "pending_independent_review"
          ]
        },
        "support_refs": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "identification_basis": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "evaluationClock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "as_of_instant",
        "default_business_timezone",
        "calendar_contract_ref",
        "release_cutoff_instant"
      ],
      "properties": {
        "as_of_instant": {
          "type": "string",
          "format": "date-time"
        },
        "default_business_timezone": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "calendar_contract_ref": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "business_day_contract_ref": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "release_cutoff_instant": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "worldContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_ref",
        "state",
        "description",
        "discoverability",
        "access_state"
      ],
      "properties": {
        "contract_ref": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "state": {
          "enum": [
            "available",
            "partial",
            "missing",
            "conflicting",
            "stale"
          ]
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "discoverability": {
          "enum": [
            "provided_to_agent",
            "discoverable_by_semantic_inspection",
            "evaluator_only"
          ]
        },
        "access_state": {
          "enum": [
            "accessible",
            "permission_required",
            "denied"
          ]
        }
      }
    },
    "dataCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition_id",
        "description",
        "discoverability",
        "materiality"
      ],
      "properties": {
        "condition_id": {
          "type": "string",
          "pattern": "^DC-[A-Z0-9-]+$"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "discoverability": {
          "enum": [
            "provided_to_agent",
            "discoverable_by_semantic_inspection",
            "discoverable_by_data_probe",
            "evaluator_only"
          ]
        },
        "materiality": {
          "enum": [
            "low",
            "material",
            "critical"
          ]
        }
      }
    },
    "decisionStakes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "business_decision",
        "consequence_of_error",
        "risk_level"
      ],
      "properties": {
        "business_decision": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "consequence_of_error": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "risk_level": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        }
      }
    },
    "supportExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_support_state",
        "contract_supported",
        "required_disposition",
        "support_evidence_refs",
        "boundary_authorizations"
      ],
      "properties": {
        "baseline_support_state": {
          "enum": [
            "supported",
            "clarification_blocked",
            "contract_blocked",
            "identification_blocked",
            "privacy_blocked"
          ]
        },
        "contract_supported": {
          "type": "boolean"
        },
        "required_disposition": {
          "enum": [
            "executable_design",
            "clarification_required",
            "typed_boundary"
          ]
        },
        "support_evidence_refs": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "boundary_authorizations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/boundaryAuthorization"
          }
        }
      }
    },
    "boundaryAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundary_code",
        "allowed_when_refs",
        "required_observation_refs",
        "maximum_claim_ceiling"
      ],
      "properties": {
        "boundary_code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]+$"
        },
        "allowed_when_refs": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "required_observation_refs": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "claim_target_ids": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "maximum_claim_ceiling": {
          "enum": [
            "definition_only",
            "data_quality_only",
            "descriptive",
            "associational",
            "accounting_attribution",
            "causal"
          ]
        }
      }
    },
    "acceptableOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "must_preserve",
        "valid_design_space",
        "must_investigate",
        "allowed_dispositions",
        "claim_ceiling",
        "clarification_policy"
      ],
      "properties": {
        "must_preserve": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "valid_design_space": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/validDesign"
          }
        },
        "must_investigate": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "allowed_dispositions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "executable_design",
              "clarification_required",
              "typed_boundary"
            ]
          }
        },
        "allowed_boundary_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "claim_ceiling": {
          "enum": [
            "definition_only",
            "data_quality_only",
            "descriptive",
            "associational",
            "accounting_attribution",
            "causal"
          ]
        },
        "claim_targets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/claimTargetExpectation"
          }
        },
        "estimands": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/estimandExpectation"
          }
        },
        "clarification_policy": {
          "$ref": "#/$defs/clarificationPolicy"
        }
      }
    },
    "claimTargetExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_target_id",
        "estimand_id",
        "target_description",
        "claim_ceiling"
      ],
      "properties": {
        "claim_target_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]+$"
        },
        "estimand_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]+$"
        },
        "target_description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "claim_ceiling": {
          "enum": [
            "definition_only",
            "data_quality_only",
            "descriptive",
            "associational",
            "accounting_attribution",
            "causal"
          ]
        }
      }
    },
    "estimandExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimand_id",
        "target_description"
      ],
      "properties": {
        "estimand_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]+$"
        },
        "target_description": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "validDesign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "design_family",
        "rationale",
        "required_properties"
      ],
      "properties": {
        "design_family": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "rationale": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "required_properties": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "clarificationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "rationale"
      ],
      "properties": {
        "mode": {
          "enum": [
            "proceed_with_recorded_inference",
            "ask_only_if_material_and_undiscoverable",
            "must_ask_before_design"
          ]
        },
        "rationale": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "forbiddenOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failure_code",
        "description",
        "severity"
      ],
      "properties": {
        "failure_code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]+$"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "severity": {
          "enum": [
            "major",
            "blocking"
          ]
        }
      }
    },
    "counterfactualSibling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sibling_id",
        "expected_relation",
        "mutation_dimension",
        "mutation_operation",
        "expected_invariants",
        "expected_changes"
      ],
      "properties": {
        "sibling_id": {
          "type": "string",
          "pattern": "^[A-Z0-9-]+-CF[0-9]{2}$"
        },
        "expected_relation": {
          "enum": [
            "meaning_preserving",
            "measurement_changing",
            "boundary_changing",
            "interaction_changing"
          ]
        },
        "mutation_dimension": {
          "enum": [
            "wording",
            "decision_goal",
            "scope",
            "metric_definition",
            "time_semantics",
            "window_or_baseline",
            "observation_unit",
            "denominator",
            "exposure",
            "data_coverage",
            "data_contract",
            "hidden_business_truth",
            "conversation_history",
            "claim_strength_request"
          ]
        },
        "mutation_operation": {
          "$ref": "#/$defs/mutationOperation"
        },
        "expected_invariants": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "expected_changes": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "mutationOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "operation",
        "value_description"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "operation": {
          "enum": [
            "add",
            "remove",
            "replace"
          ]
        },
        "value_description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "semantic_intervention_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]+$"
        },
        "before": {
          "not": {
            "type": "null"
          }
        },
        "after": {
          "not": {
            "type": "null"
          }
        },
        "materialized_sibling_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "execution_status": {
          "enum": [
            "draft_unexecutable",
            "executable_verified"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "execution_status": {
                "const": "executable_verified"
              }
            },
            "required": [
              "execution_status"
            ]
          },
          "then": {
            "required": [
              "semantic_intervention_id",
              "materialized_sibling_sha256"
            ],
            "oneOf": [
              {
                "properties": {
                  "operation": {
                    "const": "replace"
                  }
                },
                "required": [
                  "before",
                  "after"
                ]
              },
              {
                "properties": {
                  "operation": {
                    "const": "remove"
                  }
                },
                "required": [
                  "before"
                ],
                "not": {
                  "required": [
                    "after"
                  ]
                }
              },
              {
                "properties": {
                  "operation": {
                    "const": "add"
                  }
                },
                "required": [
                  "after"
                ],
                "not": {
                  "required": [
                    "before"
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    "coverageTags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_goals",
        "measurement_challenges",
        "temporal_shapes",
        "data_conditions",
        "conversation_dynamics",
        "risk_types"
      ],
      "properties": {
        "decision_goals": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "measurement_challenges": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "temporal_shapes": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "data_conditions": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "conversation_dynamics": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "risk_types": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    }
  }
}
