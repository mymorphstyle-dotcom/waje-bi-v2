{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waje.dev/schemas/evals/gate3/evaluation-episode.v5.schema.json",
  "title": "WAJE Gate 3 Behavior Evaluation Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalog_version",
    "episodes"
  ],
  "properties": {
    "catalog_version": {
      "const": "gate3.behavior-eval.v5"
    },
    "episodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evaluationEpisode"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    },
    "evaluationEpisode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episode_id",
        "title",
        "source_pool",
        "business_world_independence_key",
        "provenance",
        "suite_binding",
        "data_source_bindings",
        "user_episode",
        "business_world",
        "decision_stakes",
        "support_expectation",
        "acceptable_outcome",
        "forbidden_outcomes",
        "counterfactual_siblings",
        "coverage_tags"
      ],
      "properties": {
        "episode_id": {
          "type": "string",
          "pattern": "^G3-[A-Z]+-[0-9]{3}$"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source_pool": {
          "enum": [
            "real_user_language",
            "expert_business_case",
            "historical_failure",
            "generated_business_world",
            "adversarial_conversation"
          ]
        },
        "business_world_independence_key": {
          "type": "string",
          "pattern": "^authority-set:[a-f0-9]{64}$"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "suite_binding": {
          "$ref": "#/$defs/suiteBinding"
        },
        "data_source_bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/dataSourceBinding"
          }
        },
        "user_episode": {
          "$ref": "#/$defs/userEpisode"
        },
        "business_world": {
          "$ref": "#/$defs/businessWorld"
        },
        "decision_stakes": {
          "$ref": "#/$defs/decisionStakes"
        },
        "support_expectation": {
          "$ref": "#/$defs/supportExpectation"
        },
        "acceptable_outcome": {
          "$ref": "#/$defs/acceptableOutcome"
        },
        "forbidden_outcomes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/forbiddenOutcome"
          }
        },
        "counterfactual_siblings": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/counterfactualSibling"
          }
        },
        "coverage_tags": {
          "$ref": "#/$defs/coverageTags"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authoring_method",
        "origin_note",
        "source_record_ref",
        "authoring_batch_id"
      ],
      "properties": {
        "authoring_method": {
          "enum": [
            "domain_interview",
            "expert_authored",
            "historical_failure_reconstruction",
            "controlled_world_generation",
            "adversarial_authoring",
            "redacted_production_trace"
          ]
        },
        "origin_note": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source_record_ref": {
          "type": "string",
          "pattern": "^SRC-[A-Z0-9-]+$"
        },
        "authoring_batch_id": {
          "type": "string",
          "pattern": "^BATCH-[A-Z0-9-]+$"
        }
      }
    },
    "suiteBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "business_domain",
        "coverage_group",
        "factor_group_refs",
        "question_family_refs"
      ],
      "properties": {
        "business_domain": {
          "const": "wajegame"
        },
        "coverage_group": {
          "enum": [
            "launch_question",
            "business_chain",
            "measurement_regression",
            "authority_stress"
          ]
        },
        "factor_group_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "paid_amount_metric_source",
              "payment_order_metric_chain",
              "user_acquisition_and_first_payment",
              "payment_channel_and_method",
              "amount_tier_and_user_value",
              "marketing_channel_and_growth_ops",
              "geo_device_environment",
              "calendar_time_and_payday",
              "product_operation_events",
              "external_context_events",
              "gameplay_engagement_and_arpu",
              "gameplay_ggr_and_betting",
              "payment_status_latency_and_quality",
              "sensitive_identity_and_dedup_fields"
            ]
          }
        },
        "question_family_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "paid_amount_change_explanation",
              "pattern_explanation",
              "business_object_impact_review",
              "revenue_health_review",
              "segment_or_factor_attribution",
              "anomaly_or_black_swan_review",
              "custom_baseline_comparison",
              "data_quality_or_evidence_review"
            ]
          }
        }
      }
    },
    "dataSourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "source_mode",
        "source_ref",
        "authority_ref",
        "roles",
        "agent_access",
        "required_identity_fields",
        "materialization_status"
      ],
      "properties": {
        "binding_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]+$"
        },
        "source_mode": {
          "enum": [
            "frozen_real_snapshot",
            "controlled_synthetic_fixture",
            "known_contract_gap"
          ]
        },
        "source_ref": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "authority_ref": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "outcome",
              "numerator",
              "denominator",
              "exposure",
              "dimension",
              "event",
              "quality",
              "authority_lineage"
            ]
          }
        },
        "agent_access": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "surface",
            "available_from_turn"
          ],
          "properties": {
            "surface": {
              "enum": [
                "injected",
                "semantic_inspection",
                "data_probe",
                "authority_lookup"
              ]
            },
            "available_from_turn": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "required_identity_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "snapshot_release_ref",
              "coverage_watermark_ref",
              "query_result_ref",
              "fixture_version_ref",
              "fixture_content_sha256",
              "authority_version_ref"
            ]
          }
        },
        "materialization_status": {
          "enum": [
            "verified",
            "planned",
            "missing_by_design"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source_mode": {
                "const": "frozen_real_snapshot"
              }
            },
            "required": [
              "source_mode"
            ]
          },
          "then": {
            "properties": {
              "materialization_status": {
                "enum": [
                  "verified",
                  "planned"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_mode": {
                "const": "controlled_synthetic_fixture"
              }
            },
            "required": [
              "source_mode"
            ]
          },
          "then": {
            "properties": {
              "materialization_status": {
                "enum": [
                  "verified",
                  "planned"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_mode": {
                "const": "known_contract_gap"
              }
            },
            "required": [
              "source_mode"
            ]
          },
          "then": {
            "properties": {
              "materialization_status": {
                "const": "missing_by_design"
              }
            }
          }
        }
      ]
    },
    "userEpisode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locale",
        "messages"
      ],
      "properties": {
        "locale": {
          "type": "string",
          "minLength": 2
        },
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/userMessage"
          }
        }
      }
    },
    "userMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turn",
        "speaker",
        "trigger",
        "text"
      ],
      "properties": {
        "turn": {
          "type": "integer",
          "minimum": 1
        },
        "speaker": {
          "const": "user"
        },
        "trigger": {
          "$ref": "#/$defs/messageTrigger"
        },
        "text": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "communication_function": {
          "enum": [
            "question",
            "context",
            "correction",
            "constraint",
            "challenge",
            "scope_revision",
            "request_for_explanation"
          ]
        }
      }
    },
    "messageTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "fallback"
      ],
      "properties": {
        "kind": {
          "enum": [
            "initial",
            "after_agent_clarification",
            "after_user_visible_measurement_proposal",
            "while_investigation_pending",
            "after_user_visible_provisional_answer"
          ]
        },
        "fallback": {
          "enum": [
            "none",
            "inject_when_observable_or_mark_unreached"
          ]
        }
      }
    },
    "businessWorld": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "world_id",
        "narrative",
        "evaluation_clock",
        "available_contracts",
        "data_conditions",
        "truth_facts"
      ],
      "properties": {
        "world_id": {
          "type": "string",
          "pattern": "^WORLD-[A-Z0-9-]+$"
        },
        "narrative": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evaluation_clock": {
          "$ref": "#/$defs/evaluationClock"
        },
        "available_contracts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/worldContract"
          }
        },
        "data_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/dataCondition"
          }
        },
        "truth_facts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/truthFact"
          }
        },
        "scheduled_events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scheduledWorldEvent"
          }
        }
      }
    },
    "scheduledWorldEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "after_user_turn",
        "event_type",
        "public_payload",
        "authority_expectation"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^EVT-[A-Z0-9-]+$"
        },
        "after_user_turn": {
          "type": "integer",
          "minimum": 1
        },
        "event_type": {
          "enum": [
            "reviewer_objection",
            "effect_completed",
            "contract_release",
            "worker_restart",
            "duplicate_delivery"
          ]
        },
        "public_payload": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "affected_ref": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "authority_expectation": {
          "enum": [
            "reenter_loop",
            "reject_stale_result",
            "resume_case",
            "idempotent_noop"
          ]
        }
      }
    },
    "truthFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "truth_id",
        "statement",
        "observability",
        "identifiability"
      ],
      "properties": {
        "truth_id": {
          "type": "string",
          "pattern": "^TRUTH-[A-Z0-9-]+$"
        },
        "statement": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "observability": {
          "enum": [
            "agent_observable",
            "evaluator_only"
          ]
        },
        "identifiability": {
          "enum": [
            "identifiable_from_world",
            "latent_unidentifiable",
            "pending_independent_review"
          ]
        },
        "support_refs": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "identification_basis": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "evaluationClock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "as_of_instant",
        "default_business_timezone",
        "calendar_contract_ref",
        "release_cutoff_instant"
      ],
      "properties": {
        "as_of_instant": {
          "type": "string",
          "format": "date-time"
        },
        "default_business_timezone": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "calendar_contract_ref": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "business_day_contract_ref": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "release_cutoff_instant": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "worldContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_ref",
        "state",
        "description",
        "discoverability",
        "access_state"
      ],
      "properties": {
        "contract_ref": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "state": {
          "enum": [
            "available",
            "partial",
            "missing",
            "conflicting",
            "stale"
          ]
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "discoverability": {
          "enum": [
            "provided_to_agent",
            "discoverable_by_semantic_inspection",
            "evaluator_only"
          ]
        },
        "access_state": {
          "enum": [
            "accessible",
            "permission_required",
            "denied"
          ]
        }
      }
    },
    "dataCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition_id",
        "description",
        "discoverability",
        "materiality"
      ],
      "properties": {
        "condition_id": {
          "type": "string",
          "pattern": "^DC-[A-Z0-9-]+$"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "discoverability": {
          "enum": [
            "provided_to_agent",
            "discoverable_by_semantic_inspection",
            "discoverable_by_data_probe",
            "evaluator_only"
          ]
        },
        "materiality": {
          "enum": [
            "low",
            "material",
            "critical"
          ]
        }
      }
    },
    "decisionStakes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "business_decision",
        "consequence_of_error",
        "risk_level"
      ],
      "properties": {
        "business_decision": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "consequence_of_error": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "risk_level": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        }
      }
    },
    "supportExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authoring_status",
        "claim_cases",
        "boundary_cases",
        "completion_policy"
      ],
      "properties": {
        "authoring_status": {
          "enum": [
            "claim_cases_complete",
            "pending_claim_cases"
          ]
        },
        "claim_cases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/claimCase"
          }
        },
        "boundary_cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/boundaryCase"
          }
        },
        "completion_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "local_boundary_cannot_cancel_unaffected_claims",
            "episode_state_is_derived"
          ],
          "properties": {
            "mode": {
              "const": "claim_scoped"
            },
            "local_boundary_cannot_cancel_unaffected_claims": {
              "const": true
            },
            "episode_state_is_derived": {
              "const": true
            }
          }
        }
      }
    },
    "claimCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_target_id",
        "evaluation_turn",
        "source_uses",
        "support_state",
        "disposition",
        "applicability",
        "effective_claim_ceiling",
        "required_observation_refs",
        "oracle_truth_refs",
        "boundary_codes",
        "reversal_conditions"
      ],
      "properties": {
        "claim_target_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]+$"
        },
        "evaluation_turn": {
          "type": "integer",
          "minimum": 1
        },
        "source_uses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "binding_id",
              "requirement"
            ],
            "properties": {
              "binding_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]+$"
              },
              "requirement": {
                "enum": [
                  "required",
                  "optional",
                  "boundary_probe"
                ]
              }
            }
          }
        },
        "support_state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "data_contract_state",
            "business_evidence_state"
          ],
          "properties": {
            "data_contract_state": {
              "enum": [
                "supported",
                "partial",
                "missing",
                "conflicting",
                "stale",
                "permission_blocked"
              ]
            },
            "business_evidence_state": {
              "enum": [
                "supported",
                "partial",
                "insufficient",
                "unidentifiable",
                "not_evaluated"
              ]
            }
          }
        },
        "disposition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "resolution",
            "verifier",
            "settlement_precondition"
          ],
          "properties": {
            "resolution": {
              "enum": [
                "resolved_instance",
                "typed_resolution_boundary",
                "clarification_required",
                "omitted"
              ]
            },
            "verifier": {
              "enum": [
                "accepted",
                "boundary_only",
                "rejected",
                "not_run"
              ]
            },
            "settlement_precondition": {
              "enum": [
                "eligible_for_future_settlement",
                "blocked"
              ]
            }
          }
        },
        "applicability": {
          "enum": [
            "real_snapshot_scope",
            "fixture_only_scope",
            "mixed_scope",
            "contract_boundary_scope"
          ]
        },
        "effective_claim_ceiling": {
          "enum": [
            "definition_only",
            "data_quality_only",
            "descriptive",
            "associational",
            "accounting_attribution",
            "causal"
          ]
        },
        "required_observation_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "oracle_truth_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "boundary_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]+$"
          }
        },
        "reversal_conditions": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "boundaryCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundary_code",
        "activation",
        "allowed_when_refs",
        "required_observation_refs",
        "maximum_claim_ceiling",
        "recovery_conditions"
      ],
      "properties": {
        "boundary_code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]+$"
        },
        "allowed_when_refs": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "required_observation_refs": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "claim_target_ids": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "activation": {
          "enum": [
            "required_in_base_world",
            "allowed_if_observed"
          ]
        },
        "maximum_claim_ceiling": {
          "enum": [
            "definition_only",
            "data_quality_only",
            "descriptive",
            "associational",
            "accounting_attribution",
            "causal"
          ]
        },
        "recovery_conditions": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "acceptableOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "must_preserve",
        "design_space_policy",
        "valid_design_space",
        "must_investigate",
        "permitted_resolution_kinds",
        "claim_targets",
        "estimands",
        "clarification_policy"
      ],
      "properties": {
        "must_preserve": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "design_space_policy": {
          "$ref": "#/$defs/designSpacePolicy"
        },
        "valid_design_space": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/validDesign"
          }
        },
        "must_investigate": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "permitted_resolution_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "resolved_instance",
              "clarification_required",
              "typed_resolution_boundary",
              "omitted"
            ]
          }
        },
        "allowed_boundary_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "claim_targets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/claimTargetExpectation"
          }
        },
        "estimands": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/estimandExpectation"
          }
        },
        "clarification_policy": {
          "$ref": "#/$defs/clarificationPolicy"
        }
      }
    },
    "claimTargetExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_target_id",
        "estimand_id",
        "claim_target_kind",
        "target_description",
        "design_claim_ceiling"
      ],
      "properties": {
        "claim_target_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]+$"
        },
        "estimand_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]+$"
        },
        "claim_target_kind": {
          "enum": [
            "definition",
            "data_quality_state",
            "point_quantity",
            "distribution",
            "temporal_pattern",
            "contrast",
            "composition",
            "accounting_decomposition",
            "cohort_outcome",
            "funnel_transition",
            "association",
            "causal_effect",
            "diagnostic_set"
          ]
        },
        "target_description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "design_claim_ceiling": {
          "enum": [
            "definition_only",
            "data_quality_only",
            "descriptive",
            "associational",
            "accounting_attribution",
            "causal"
          ]
        }
      }
    },
    "estimandExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimand_id",
        "target_description"
      ],
      "properties": {
        "estimand_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]+$"
        },
        "target_description": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "validDesign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "design_family",
        "rationale",
        "required_properties"
      ],
      "properties": {
        "design_family": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "rationale": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "required_properties": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "designSpacePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "open_world_acceptance",
        "authored_examples_role",
        "acceptance_authority_refs",
        "disqualifier_codes"
      ],
      "properties": {
        "open_world_acceptance": {"const": true},
        "authored_examples_role": {
          "const": "illustrative_non_exhaustive"
        },
        "acceptance_authority_refs": {
          "type": "array",
          "const": [
            "must_preserve",
            "must_investigate",
            "claim_targets",
            "support_expectation",
            "forbidden_outcomes"
          ]
        },
        "disqualifier_codes": {
          "type": "array",
          "const": [
            "must_preserve_violated",
            "required_investigation_omitted",
            "claim_ceiling_exceeded",
            "forbidden_outcome_matched",
            "evidence_or_authority_boundary_violated"
          ]
        }
      }
    },
    "clarificationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "rationale"
      ],
      "properties": {
        "mode": {
          "enum": [
            "proceed_with_recorded_inference",
            "ask_only_if_material_and_undiscoverable",
            "must_ask_before_design"
          ]
        },
        "rationale": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "forbiddenOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failure_code",
        "description",
        "severity"
      ],
      "properties": {
        "failure_code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]+$"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "severity": {
          "enum": [
            "major",
            "blocking"
          ]
        }
      }
    },
    "counterfactualSibling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sibling_id",
        "expected_relation",
        "mutation_dimension",
        "affected_claim_target_ids",
        "mutation_operation",
        "expected_authority_effects",
        "expected_invariants",
        "expected_changes"
      ],
      "properties": {
        "sibling_id": {
          "type": "string",
          "pattern": "^[A-Z0-9-]+-CF[0-9]{2}$"
        },
        "expected_relation": {
          "enum": [
            "meaning_preserving",
            "measurement_changing",
            "boundary_changing",
            "interaction_changing"
          ]
        },
        "mutation_dimension": {
          "enum": [
            "wording",
            "decision_goal",
            "scope",
            "metric_definition",
            "time_semantics",
            "window_or_baseline",
            "observation_unit",
            "denominator",
            "exposure",
            "data_coverage",
            "data_contract",
            "hidden_business_truth",
            "conversation_history",
            "claim_strength_request"
          ]
        },
        "affected_claim_target_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]+$"
          }
        },
        "mutation_operation": {
          "$ref": "#/$defs/mutationOperation"
        },
        "expected_authority_effects": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "measurement_identity",
            "prior_evidence",
            "claim_case_disposition"
          ],
          "properties": {
            "measurement_identity": {
              "enum": [
                "preserve",
                "revise"
              ]
            },
            "prior_evidence": {
              "enum": [
                "reusable",
                "revalidate",
                "reject",
                "mixed"
              ]
            },
            "claim_case_disposition": {
              "enum": [
                "preserve",
                "recompute",
                "degrade_or_omit",
                "mixed"
              ]
            }
          }
        },
        "claim_effects": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/counterfactualClaimEffect"
          }
        },
        "replacement_expectation": {
          "$ref": "#/$defs/replacementExpectation"
        },
        "unaffected_claim_target_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]+$"
          }
        },
        "expected_invariants": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "expected_changes": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "replacementExpectation": {
      "description": "Claim obligations that answer the materially revised user goal. Existing claims are hash-bound projections of reviewed base gold; genuinely new claims require separately authored variant gold.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "derivation",
        "source_intervention_sha256",
        "base_claim_refs",
        "variant_estimands",
        "variant_claim_targets",
        "variant_claim_cases",
        "variant_boundary_cases",
        "content_sha256"
      ],
      "properties": {
        "derivation": {
          "enum": [
            "base_claim_effect_projection",
            "variant_authored_gold"
          ]
        },
        "source_intervention_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "base_claim_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/replacementBaseClaimRef"
          }
        },
        "variant_estimands": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/estimandExpectation"
          }
        },
        "variant_claim_targets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/claimTargetExpectation"
          }
        },
        "variant_claim_cases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/claimCase"
          }
        },
        "variant_boundary_cases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/boundaryCase"
          }
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "replacementBaseClaimRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_target_id",
        "estimand_id",
        "base_claim_case_sha256",
        "claim_effect_sha256"
      ],
      "properties": {
        "claim_target_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]+$"
        },
        "estimand_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]+$"
        },
        "base_claim_case_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "claim_effect_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "counterfactualClaimEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_target_id",
        "base_claim_case_sha256",
        "measurement_identity",
        "prior_evidence",
        "support_state",
        "claim_case_disposition",
        "claim_ceiling",
        "boundary_codes"
      ],
      "properties": {
        "claim_target_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]+$"
        },
        "base_claim_case_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "measurement_identity": {
          "enum": [
            "preserve",
            "revise"
          ]
        },
        "prior_evidence": {
          "enum": [
            "reusable",
            "revalidate",
            "reject"
          ]
        },
        "support_state": {
          "enum": [
            "preserve",
            "recompute",
            "degrade_or_recompute",
            "not_applicable"
          ]
        },
        "claim_case_disposition": {
          "enum": [
            "preserve",
            "recompute",
            "degrade_or_omit",
            "supersede_or_omit"
          ]
        },
        "claim_ceiling": {
          "enum": [
            "preserve",
            "recompute",
            "lower_or_preserve",
            "not_applicable"
          ]
        },
        "boundary_codes": {
          "enum": [
            "preserve",
            "recompute",
            "expand_or_preserve",
            "clear"
          ]
        }
      }
    },
    "mutationOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patches",
        "value_description",
        "authority_surface",
        "execution_status"
      ],
      "properties": {
        "patches": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/mutationPatch"
          }
        },
        "value_description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "authority_surface": {
          "enum": [
            "user_message",
            "world_fixture",
            "semantic_contract",
            "composite_authority"
          ]
        },
        "semantic_intervention_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]+$"
        },
        "materialized_sibling_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "execution_status": {
          "description": "executable_verified proves exact mutation replay, schema validity and digest identity. Independent business and measurement review is still required before the sibling becomes evaluation gold.",
          "enum": [
            "draft_unexecutable",
            "executable_verified"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "execution_status": {
                "const": "executable_verified"
              }
            },
            "required": [
              "execution_status"
            ]
          },
          "then": {
            "required": [
              "semantic_intervention_id",
              "materialized_sibling_sha256"
            ],
            "properties": {
              "patches": {
                "items": {
                  "$ref": "#/$defs/executableMutationPatch"
                }
              }
            }
          }
        }
      ]
    },
    "mutationPatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "operation"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "operation": {
          "enum": [
            "add",
            "remove",
            "replace"
          ]
        },
        "before": {
          "not": {
            "type": "null"
          }
        },
        "after": {
          "not": {
            "type": "null"
          }
        }
      }
    },
    "executableMutationPatch": {
      "allOf": [
        {
          "$ref": "#/$defs/mutationPatch"
        },
        {
          "oneOf": [
            {
              "properties": {
                "operation": {
                  "const": "replace"
                }
              },
              "required": [
                "before",
                "after"
              ]
            },
            {
              "properties": {
                "operation": {
                  "const": "remove"
                }
              },
              "required": [
                "before"
              ],
              "not": {
                "required": [
                  "after"
                ]
              }
            },
            {
              "properties": {
                "operation": {
                  "const": "add"
                }
              },
              "required": [
                "after"
              ],
              "not": {
                "required": [
                  "before"
                ]
              }
            }
          ]
        }
      ]
    },
    "coverageTags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_goals",
        "measurement_challenges",
        "temporal_shapes",
        "data_conditions",
        "conversation_dynamics",
        "risk_types"
      ],
      "properties": {
        "decision_goals": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "measurement_challenges": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "temporal_shapes": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "data_conditions": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "conversation_dynamics": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "risk_types": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    }
  }
}
