{
  "policy_version": "gate3.behavior-eval-policy.v1",
  "corpus_authority": {
    "review_required": [
      "business_owner",
      "measurement_reviewer"
    ],
    "run_manifest_can_weaken_expectations": false,
    "eval_failure_auto_promotes_runtime_guardrail": false,
    "held_out_content_visible_to_prompt_development": false
  },
  "minimum_catalog": {
    "reviewed_base_episodes": 36,
    "source_pool_minimums": {
      "real_user_language": 6,
      "expert_business_case": 6,
      "historical_failure": 6,
      "generated_business_world": 6,
      "adversarial_conversation": 6
    },
    "counterfactual_siblings_per_episode": 3,
    "required_counterfactual_roles_per_episode": [
      "meaning_preserving",
      "measurement_changing",
      "boundary_changing_or_interaction_changing"
    ],
    "multi_turn_episodes": 12,
    "critical_risk_episodes": 6
  },
  "required_coverage": {
    "decision_goals": [
      "define",
      "estimate",
      "compare",
      "diagnose",
      "attribute",
      "validate",
      "challenge",
      "recommend_with_boundary"
    ],
    "measurement_challenges": [
      "denominator",
      "exposure",
      "observation_unit",
      "window_or_baseline",
      "distribution",
      "cohort_or_risk_set",
      "funnel_or_sequence",
      "decomposition",
      "association_or_causal_ceiling",
      "multi_estimand"
    ],
    "temporal_shapes": [
      "no_time",
      "absolute",
      "relative",
      "cross_month",
      "cross_year",
      "partial_period",
      "timezone_or_business_day"
    ],
    "data_conditions": [
      "complete",
      "partial_coverage",
      "missing_contract",
      "conflicting_contract",
      "stale_release",
      "late_arrival",
      "contradictory_evidence"
    ],
    "conversation_dynamics": [
      "single_turn",
      "clarification",
      "correction",
      "scope_revision",
      "challenge",
      "long_context_noise",
      "concurrent_message"
    ],
    "risk_types": [
      "authority_drift",
      "wrong_business_decision",
      "over_strong_claim",
      "hidden_data_gap",
      "misleading_comparison",
      "out_of_scope_request"
    ]
  },
  "run_policy": {
    "hidden_business_truth_visible_to_agent": false,
    "future_user_messages_visible_before_injection": false,
    "evaluator_only_conditions_visible_to_agent": false,
    "source_provenance_visible_to_agent": false,
    "critical_forbidden_outcomes_allowed": 0,
    "authority_drift_allowed": 0,
    "contract_supported_boundary_escape_allowed": 0,
    "critical_episode_paraphrases": 3,
    "critical_episode_repeats_per_paraphrase": 3,
    "high_risk_full_trace_paraphrases": 2,
    "high_risk_full_trace_repeats": 2,
    "semantic_grader_requires_human_calibration": true,
    "aggregate_score_can_mask_critical_failure": false
  }
}
