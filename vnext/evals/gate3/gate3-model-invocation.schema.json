{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waje.dev/schemas/evals/gate3/model-invocation.v1.schema.json",
  "title": "WAJE Gate 3 Model Invocation Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "artifact_version",
    "execution_cell_id",
    "execution_attempt_id",
    "case_id",
    "logical_model_job_id",
    "provider_attempt_id",
    "role",
    "evaluator_profile_ref",
    "evaluator_profile_sha256",
    "provider_ref",
    "model_ref",
    "thinking",
    "configuration_sha256",
    "prompt_bundle_sha256",
    "input_contract_sha256",
    "output_contract_sha256",
    "request_sha256",
    "disposition",
    "authority_snapshot_sha256",
    "causation_id",
    "correlation_id",
    "started_at",
    "completed_at"
  ],
  "properties": {
    "artifact_type": {"const": "gate3_model_invocation"},
    "artifact_version": {"const": "gate3.model-invocation.v1"},
    "execution_cell_id": {"$ref": "#/$defs/nonEmptyString"},
    "execution_attempt_id": {"$ref": "#/$defs/nonEmptyString"},
    "case_id": {"$ref": "#/$defs/nonEmptyString"},
    "logical_model_job_id": {"$ref": "#/$defs/nonEmptyString"},
    "provider_attempt_id": {"$ref": "#/$defs/nonEmptyString"},
    "role": {
      "enum": [
        "primary_business_analysis_agent",
        "message_binding",
        "runtime_reviewer",
        "evaluation_reviewer"
      ]
    },
    "evaluator_profile_ref": {"$ref": "#/$defs/nonEmptyString"},
    "evaluator_profile_sha256": {"$ref": "#/$defs/sha256"},
    "provider_ref": {"$ref": "#/$defs/nonEmptyString"},
    "model_ref": {"$ref": "#/$defs/nonEmptyString"},
    "thinking": {"enum": ["enabled", "disabled"]},
    "configuration_sha256": {"$ref": "#/$defs/sha256"},
    "prompt_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "input_contract_sha256": {"$ref": "#/$defs/sha256"},
    "output_contract_sha256": {"$ref": "#/$defs/sha256"},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "provider_response_id": {"$ref": "#/$defs/nonEmptyString"},
    "disposition": {
      "enum": [
        "succeeded",
        "retryable_failure",
        "terminal_failure",
        "refusal",
        "incomplete",
        "multiple_tool_calls",
        "superseded"
      ]
    },
    "typed_output_sha256": {"$ref": "#/$defs/sha256"},
    "typed_output_artifact_ref": {"$ref": "#/$defs/nonEmptyString"},
    "failure_code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]+$"
    },
    "authority_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "causation_id": {"$ref": "#/$defs/nonEmptyString"},
    "correlation_id": {"$ref": "#/$defs/nonEmptyString"},
    "usage": {"type": "object"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"disposition": {"const": "succeeded"}}},
      "then": {"required": ["provider_response_id", "typed_output_sha256", "typed_output_artifact_ref"]},
      "else": {"required": ["failure_code"]}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nonEmptyString": {"type": "string", "minLength": 1}
  }
}
