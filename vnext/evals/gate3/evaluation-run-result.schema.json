{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waje.dev/schemas/evals/gate3/evaluation-run-result.v1.schema.json",
  "title": "WAJE Gate 3 Evaluation Run Cell Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result_version",
    "run_cell_id",
    "run_manifest_sha256",
    "episode_id",
    "episode_core_sha256",
    "world_profile_ref",
    "world_profile_sha256",
    "authority_profile_ref",
    "authority_profile_sha256",
    "product_grader_profile_ref",
    "layer_results",
    "critical_vetoes",
    "artifact_completeness",
    "leakage_detected",
    "derived_final_verdict"
  ],
  "properties": {
    "result_version": {
      "const": "gate3.eval-result.v1"
    },
    "run_cell_id": {
      "type": "string",
      "minLength": 1
    },
    "run_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "episode_core_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "episode_id": {
      "type": "string",
      "pattern": "^G3-[A-Z]+-[0-9]{3}$"
    },
    "world_profile_ref": {
      "type": "string",
      "minLength": 1
    },
    "world_profile_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "authority_profile_ref": {
      "type": "string",
      "minLength": 1
    },
    "authority_profile_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "product_grader_profile_ref": {
      "type": "string",
      "minLength": 1
    },
    "layer_results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_behavior",
        "authority_conformance",
        "implementation"
      ],
      "properties": {
        "product_behavior": {
          "$ref": "#/$defs/layerResult"
        },
        "authority_conformance": {
          "$ref": "#/$defs/layerResult"
        },
        "implementation": {
          "$ref": "#/$defs/layerResult"
        }
      }
    },
    "critical_vetoes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "artifact_completeness": {
      "type": "boolean"
    },
    "leakage_detected": {
      "type": "boolean"
    },
    "derived_final_verdict": {
      "$ref": "#/$defs/verdict"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "verdict": {
      "enum": [
        "pass",
        "fail",
        "blocked",
        "invalid"
      ]
    },
    "layerResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "check_results",
        "artifact_sha256s"
      ],
      "properties": {
        "verdict": {
          "$ref": "#/$defs/verdict"
        },
        "check_results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "check_id",
              "verdict"
            ],
            "properties": {
              "check_id": {
                "type": "string",
                "minLength": 1
              },
              "verdict": {
                "$ref": "#/$defs/verdict"
              }
            }
          }
        },
        "artifact_sha256s": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    }
  }
}
