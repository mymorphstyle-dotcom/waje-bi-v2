{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waje.dev/schemas/evals/gate3/runtime-model-execution.v1.schema.json",
  "title": "WAJE Gate 3 Runtime Model Execution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "artifact_version",
    "execution_manifest_sha256",
    "execution_cell_id",
    "execution_attempt_id",
    "run_trace_manifest_id",
    "run_trace_manifest_sha256",
    "evaluator_profile_ref",
    "evaluator_profile_sha256",
    "source_proof",
    "logical_model_job",
    "attempts",
    "durable_result",
    "trace_output_binding",
    "runtime_record_set_sha256"
  ],
  "properties": {
    "artifact_type": {"const": "gate3_runtime_model_execution"},
    "artifact_version": {"const": "gate3.runtime-model-execution.v1"},
    "execution_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "execution_cell_id": {"$ref": "#/$defs/nonEmptyString"},
    "execution_attempt_id": {"$ref": "#/$defs/nonEmptyString"},
    "run_trace_manifest_id": {"$ref": "#/$defs/nonEmptyString"},
    "run_trace_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "evaluator_profile_ref": {"$ref": "#/$defs/nonEmptyString"},
    "evaluator_profile_sha256": {"$ref": "#/$defs/sha256"},
    "source_proof": {"$ref": "#/$defs/sourceProof"},
    "logical_model_job": {"type": "object"},
    "attempts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/attempt"}
    },
    "durable_result": {"type": "object"},
    "trace_output_binding": {"$ref": "#/$defs/traceOutputBinding"},
    "runtime_record_set_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nonEmptyString": {"type": "string", "minLength": 1},
    "sourceProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "runtime_store_ref",
        "snapshot_ref",
        "export_attestation_ref"
      ],
      "properties": {
        "mode": {
          "enum": [
            "development_self_attested",
            "direct_store_read",
            "signed_export"
          ]
        },
        "runtime_store_ref": {"$ref": "#/$defs/nonEmptyString"},
        "snapshot_ref": {"$ref": "#/$defs/nonEmptyString"},
        "export_attestation_ref": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/nonEmptyString"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "signed_export"}}},
          "then": {"properties": {"export_attestation_ref": {"$ref": "#/$defs/nonEmptyString"}}},
          "else": {"properties": {"export_attestation_ref": {"type": "null"}}}
        }
      ]
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "receipt"],
      "properties": {
        "request": {"type": "object"},
        "receipt": {"type": "object"}
      }
    },
    "traceOutputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_id", "artifact_ref"],
      "properties": {
        "stage_id": {"$ref": "#/$defs/nonEmptyString"},
        "artifact_ref": {"$ref": "#/$defs/nonEmptyString"}
      }
    }
  }
}
