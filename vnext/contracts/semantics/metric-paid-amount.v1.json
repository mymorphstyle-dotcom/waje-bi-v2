{
  "contract_id": "metric:paid_amount:v1",
  "name": "Paid amount",
  "definition": "Gross amount from final successful payment records after order-level deduplication",
  "currency": "NGN",
  "valid_status": "pay_success",
  "excluded_statuses": [
    "order_success"
  ],
  "deduplication": {
    "key": "order_id",
    "keep": "latest_payment_completion"
  },
  "business_time": {
    "timezone": "Africa/Lagos",
    "date_source": "payment_completion_time",
    "day_interval": "[00:00,24:00)"
  },
  "supported_daily_measure": "non_cumulative_paid_amount",
  "blocked_daily_measure": "cumulative_month_to_date_paid_amount"
}
