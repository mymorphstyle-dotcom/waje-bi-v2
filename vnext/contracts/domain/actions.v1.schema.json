{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:waje-vnext:domain:actions:v1",
  "title": "WAJE vNext Primary Agent actions v1",
  "allOf": [
    {
      "oneOf": [
        {
          "$ref": "#/$defs/reviseFrameAction"
        },
        {
          "$ref": "#/$defs/revisePlanAction"
        },
        {
          "$ref": "#/$defs/inspectSemanticsAction"
        },
        {
          "$ref": "#/$defs/runProbeAction"
        },
        {
          "$ref": "#/$defs/callCapabilityAction"
        },
        {
          "$ref": "#/$defs/runSensitivityAction"
        },
        {
          "$ref": "#/$defs/recordInterpretationAction"
        },
        {
          "$ref": "#/$defs/askUserAction"
        },
        {
          "$ref": "#/$defs/proposeAnswerAction"
        },
        {
          "$ref": "#/$defs/stopAction"
        }
      ]
    },
    {
      "oneOf": [
        {
          "required": [
            "action_id",
            "case_id",
            "expected_head_version",
            "idempotency_key",
            "issued_at"
          ]
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "action_id"
                ]
              },
              {
                "required": [
                  "case_id"
                ]
              },
              {
                "required": [
                  "expected_head_version"
                ]
              },
              {
                "required": [
                  "idempotency_key"
                ]
              },
              {
                "required": [
                  "issued_at"
                ]
              }
            ]
          }
        }
      ]
    }
  ],
  "$defs": {
    "actionBase": {
      "type": "object",
      "properties": {
        "action_id": {
          "type": "string",
          "minLength": 1
        },
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "expected_head_version": {
          "type": "integer",
          "minimum": 0
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "reviseFrameAction": {
      "allOf": [
        {
          "$ref": "#/$defs/actionBase"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "const": "revise_frame"
            },
            "payload": {
              "$ref": "#/$defs/reviseFrame"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "revisePlanAction": {
      "allOf": [
        {
          "$ref": "#/$defs/actionBase"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "const": "revise_plan"
            },
            "payload": {
              "$ref": "#/$defs/revisePlan"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "inspectSemanticsAction": {
      "allOf": [
        {
          "$ref": "#/$defs/actionBase"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "const": "inspect_semantics"
            },
            "payload": {
              "$ref": "#/$defs/inspectSemantics"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "runProbeAction": {
      "allOf": [
        {
          "$ref": "#/$defs/actionBase"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "const": "run_probe"
            },
            "payload": {
              "$ref": "#/$defs/runProbe"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "callCapabilityAction": {
      "allOf": [
        {
          "$ref": "#/$defs/actionBase"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "const": "call_capability"
            },
            "payload": {
              "$ref": "#/$defs/callCapability"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "runSensitivityAction": {
      "allOf": [
        {
          "$ref": "#/$defs/actionBase"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "const": "run_sensitivity"
            },
            "payload": {
              "$ref": "#/$defs/runSensitivity"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "recordInterpretationAction": {
      "allOf": [
        {
          "$ref": "#/$defs/actionBase"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "const": "record_interpretation"
            },
            "payload": {
              "$ref": "#/$defs/recordInterpretation"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "askUserAction": {
      "allOf": [
        {
          "$ref": "#/$defs/actionBase"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "const": "ask_user"
            },
            "payload": {
              "$ref": "#/$defs/askUser"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "proposeAnswerAction": {
      "allOf": [
        {
          "$ref": "#/$defs/actionBase"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "const": "propose_answer"
            },
            "payload": {
              "$ref": "#/$defs/proposeAnswer"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "stopAction": {
      "allOf": [
        {
          "$ref": "#/$defs/actionBase"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "const": "stop"
            },
            "payload": {
              "$ref": "#/$defs/stop"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "comparisonGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group_id",
        "label",
        "role",
        "membership_rule"
      ],
      "properties": {
        "group_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "focal",
            "reference"
          ]
        },
        "membership_rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "comparisonDesign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "groups",
        "contrast"
      ],
      "properties": {
        "mode": {
          "enum": [
            "absolute",
            "between_groups",
            "within_unit",
            "counterfactual"
          ]
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/comparisonGroup"
          }
        },
        "contrast": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "exposureDesign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variable",
        "unit",
        "balance_assumption",
        "sensitivity_adjustments",
        "normalization_strategy",
        "diagnostic_requirement_id",
        "sensitivity_requirement_id"
      ],
      "properties": {
        "variable": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "balance_assumption": {
          "enum": [
            "unknown",
            "expected_equal",
            "expected_unequal"
          ]
        },
        "sensitivity_adjustments": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "none",
              "per_exposure_unit",
              "model_adjusted",
              "stratified",
              "design_equalized",
              "other"
            ]
          }
        },
        "normalization_strategy": {
          "type": "string",
          "minLength": 1
        },
        "diagnostic_requirement_id": {
          "type": "string",
          "minLength": 1
        },
        "sensitivity_requirement_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "estimatorSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quantity",
        "aggregation",
        "numerator",
        "denominator",
        "exposure_adjustment"
      ],
      "properties": {
        "quantity": {
          "type": "string",
          "minLength": 1
        },
        "aggregation": {
          "enum": [
            "sum",
            "mean",
            "ratio",
            "rate",
            "difference",
            "model_based",
            "other"
          ]
        },
        "numerator": {
          "type": "string",
          "minLength": 1
        },
        "denominator": {
          "type": "string",
          "minLength": 1
        },
        "exposure_adjustment": {
          "enum": [
            "none",
            "per_exposure_unit",
            "model_adjusted",
            "stratified",
            "design_equalized",
            "other"
          ]
        }
      }
    },
    "frameRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "kind",
        "question",
        "success_condition",
        "failure_consequence"
      ],
      "properties": {
        "requirement_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "semantic",
            "coverage",
            "exposure",
            "sensitivity",
            "alternative",
            "falsification"
          ]
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "success_condition": {
          "type": "string",
          "minLength": 1
        },
        "failure_consequence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "alternativeHypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alternative_id",
        "statement",
        "requirement_id"
      ],
      "properties": {
        "alternative_id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "requirement_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "parameters": {
      "type": "object"
    },
    "reviseFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision_reason",
        "estimand",
        "population",
        "time_scope",
        "observation_unit",
        "primary_estimator",
        "exposure",
        "comparison",
        "measurement_rationale",
        "assumptions",
        "alternatives",
        "requirements",
        "falsification_conditions",
        "reversal_conditions",
        "success_conditions",
        "stop_conditions",
        "decision_record_ids",
        "semantic_contract_refs"
      ],
      "properties": {
        "revision_reason": {
          "type": "string",
          "minLength": 1
        },
        "estimand": {
          "type": "string",
          "minLength": 1
        },
        "population": {
          "type": "string",
          "minLength": 1
        },
        "time_scope": {
          "type": "string",
          "minLength": 1
        },
        "observation_unit": {
          "type": "string",
          "minLength": 1
        },
        "primary_estimator": {
          "$ref": "#/$defs/estimatorSpec"
        },
        "exposure": {
          "$ref": "#/$defs/exposureDesign"
        },
        "comparison": {
          "$ref": "#/$defs/comparisonDesign"
        },
        "measurement_rationale": {
          "type": "string",
          "minLength": 1
        },
        "assumptions": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "alternatives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/alternativeHypothesis"
          }
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/frameRequirement"
          }
        },
        "falsification_conditions": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "reversal_conditions": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "success_conditions": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "stop_conditions": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "decision_record_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "semantic_contract_refs": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "revisePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision_reason",
        "tasks"
      ],
      "properties": {
        "revision_reason": {
          "type": "string",
          "minLength": 1
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/workTask"
          }
        }
      }
    },
    "workTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "business_purpose",
        "capability_intent",
        "target_claim_ids",
        "requirement_ids",
        "depends_on_task_ids",
        "success_conditions",
        "stop_conditions"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "business_purpose": {
          "type": "string",
          "minLength": 1
        },
        "capability_intent": {
          "type": "string",
          "minLength": 1
        },
        "target_claim_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "requirement_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "depends_on_task_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "success_conditions": {
          "$ref": "#/$defs/stringArray"
        },
        "stop_conditions": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "inspectSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "contract_refs"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "contract_refs": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "runProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "probe_kind",
        "parameters"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "probe_kind": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "$ref": "#/$defs/parameters"
        }
      }
    },
    "callCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "capability_name",
        "parameters"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "capability_name": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "$ref": "#/$defs/parameters"
        }
      }
    },
    "runSensitivity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "variant_label",
        "parameters"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "variant_label": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "$ref": "#/$defs/parameters"
        }
      }
    },
    "recordInterpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_record_ids",
        "interpretation"
      ],
      "properties": {
        "evidence_record_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "interpretation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "decisionOption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "option_id",
        "label",
        "impact"
      ],
      "properties": {
        "option_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "impact": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "askUser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "options",
        "recommended_option_id",
        "allow_freeform"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/decisionOption"
          }
        },
        "recommended_option_id": {
          "type": "string",
          "minLength": 1
        },
        "allow_freeform": {
          "const": true
        }
      }
    },
    "proposeAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claims",
        "narrative_markdown"
      ],
      "properties": {
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/proposedClaim"
          }
        },
        "narrative_markdown": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "proposedClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "statement",
        "applicability",
        "evidence_record_ids",
        "boundary_ref",
        "limitations"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "applicability": {
          "type": "string",
          "minLength": 1
        },
        "evidence_record_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "boundary_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "limitations": {
          "$ref": "#/$defs/stringArray"
        }
      },
      "anyOf": [
        {
          "properties": {
            "evidence_record_ids": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "boundary_ref": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "stop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "terminal_state"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "terminal_state": {
          "enum": [
            "stopped",
            "closed"
          ]
        }
      }
    }
  }
}
