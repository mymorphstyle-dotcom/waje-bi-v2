        "capability_intent_registry_sha256": {
          "type": "string"
        },
        "adoption_policy_version": {
          "type": "string"
        },
        "derivation_proof_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "schema_epoch": {
          "const": 3
        }
      }
