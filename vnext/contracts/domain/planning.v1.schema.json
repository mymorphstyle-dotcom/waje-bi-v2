{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:waje-vnext:domain:planning:v1",
  "title": "WAJE vNext Gate 3.4 logical planning contracts",
  "oneOf": [
    {
      "$ref": "#/$defs/PlanAdoptionRecord"
    },
    {
      "$ref": "#/$defs/QueryBindingEnvelope"
    },
    {
      "$ref": "#/$defs/ConformanceExecutionSpec"
    },
    {
      "$ref": "#/$defs/LogicalExecutionAttempt"
    }
