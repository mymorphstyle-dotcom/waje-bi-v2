        "frame_content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "plan_content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "resolution_outcome_ids": {
          "type": "array",
