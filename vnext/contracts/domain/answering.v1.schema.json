    "AnalysisCheckDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_disposition_id",
        "check_id",
        "kind",
        "status",
        "source_authority_ref",
        "source_authority_content_sha256",
        "limitation_ref",
        "policy_version"
      ],
      "properties": {
        "check_disposition_id": {
          "type": "string"
        },
        "check_id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "contradiction",
            "falsification",
            "reversal"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "satisfied",
            "triggered",
            "resolved_with_limitation",
            "unresolved"
          ]
        },
        "source_authority_ref": {
          "type": "string"
        },
        "source_authority_content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "limitation_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "policy_version": {
          "type": "string"
        }
      }
    },
    "ProvisionalAnswerCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answer_candidate_id",
        "case_id",
        "question_revision_id",
        "frame_revision_id",
        "plan_revision_id",
        "plan_adoption_id",
        "plan_adoption_content_sha256",
        "authority_snapshot",
        "authority_snapshot_content_sha256",
        "accepted_head_version",
        "version_number",
        "prior_answer_version_id",
        "claims",
        "narrative_blocks",
        "created_by_action_id",
        "created_at",
        "identity_version",
        "schema_epoch"
