{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:waje-vnext:domain:actions:v3",
  "title": "WAJE vNext typed agent action proposal v3",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "payload"
      ],
      "properties": {
        "kind": {
          "const": "revise_frame"
        },
        "payload": {
          "$ref": "#/$defs/ReviseFramePayload"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "payload"
      ],
      "properties": {
        "kind": {
          "const": "revise_plan"
        },
        "payload": {
          "$ref": "#/$defs/RevisePlanPayload"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "payload"
      ],
      "properties": {
        "kind": {
          "const": "inspect_semantics"
        },
        "payload": {
          "$ref": "#/$defs/InspectSemanticsPayload"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "payload"
      ],
      "properties": {
        "kind": {
          "const": "run_probe"
        },
        "payload": {
          "$ref": "#/$defs/RunProbePayload"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "payload"
      ],
      "properties": {
        "kind": {
          "const": "call_capability"
        },
        "payload": {
          "$ref": "#/$defs/CallCapabilityPayload"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "payload"
      ],
      "properties": {
        "kind": {
          "const": "run_sensitivity"
        },
        "payload": {
          "$ref": "#/$defs/RunSensitivityPayload"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "payload"
      ],
      "properties": {
        "kind": {
          "const": "record_interpretation"
        },
        "payload": {
          "$ref": "#/$defs/RecordInterpretationPayload"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "payload"
      ],
      "properties": {
        "kind": {
          "const": "ask_user"
        },
        "payload": {
          "$ref": "#/$defs/AskUserPayload"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "payload"
      ],
      "properties": {
        "kind": {
          "const": "propose_answer"
        },
        "payload": {
          "$ref": "#/$defs/ProposeAnswerPayload"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "payload"
      ],
      "properties": {
        "kind": {
          "const": "stop"
        },
        "payload": {
          "$ref": "#/$defs/StopPayload"
        }
      }
    }
  ],
  "$defs": {
    "jsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    },
    "ReviseFramePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_revision_id",
        "revision_reason_ref",
        "measurement_design"
      ],
      "properties": {
        "question_revision_id": {
          "type": "string"
        },
        "revision_reason_ref": {
          "type": "string"
        },
        "measurement_design": {
          "$ref": "#/$defs/MeasurementDesign"
        }
      }
    },
    "MeasurementDesign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_grounding",
        "decision_objective",
        "variables",
        "events",
        "populations",
        "observation_units",
        "metric_expressions",
        "temporal_semantics",
        "window_rules",
        "exposures",
        "estimators",
        "contrasts",
        "eligibilities",
        "sequences",
        "cohort_risk_sets",
        "reconciliations",
        "relationships",
        "identifications",
        "assumptions",
        "alternatives",
        "sensitivities",
        "falsifications",
        "reversals",
        "scopes",
        "evidence_requirements",
        "completion_specs",
        "estimands"
      ],
      "properties": {
        "question_grounding": {
          "$ref": "#/$defs/QuestionGrounding"
        },
        "decision_objective": {
          "$ref": "#/$defs/DecisionObjective"
        },
        "variables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VariableSpec"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EventSpec"
          }
        },
        "populations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PopulationSpec"
          }
        },
        "observation_units": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObservationUnitSpec"
          }
        },
        "metric_expressions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MetricExpression"
          }
        },
        "temporal_semantics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TemporalSemanticSpec"
          }
        },
        "window_rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WindowRuleSpec"
          }
        },
        "exposures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExposureSpec"
          }
        },
        "estimators": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EstimatorSpec"
          }
        },
        "contrasts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContrastSpec"
          }
        },
        "eligibilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EligibilitySpec"
          }
        },
        "sequences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SequenceSpec"
          }
        },
        "cohort_risk_sets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CohortRiskSetSpec"
          }
        },
        "reconciliations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReconciliationSpec"
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RelationshipSpec"
          }
        },
        "identifications": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IdentificationSpec"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AssumptionSpec"
          }
        },
        "alternatives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AlternativeSpec"
          }
        },
        "sensitivities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SensitivitySpec"
          }
        },
        "falsifications": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FalsificationSpec"
          }
        },
        "reversals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReversalSpec"
          }
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScopeExpression"
          }
        },
        "evidence_requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceRequirementSpec"
          }
        },
        "completion_specs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EpistemicCompletionSpec"
          }
        },
        "estimands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EstimandSpec"
          }
        }
      }
    },
    "QuestionGrounding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grounding_id",
        "question_revision_id",
        "source_spans",
        "decision_record_ids",
        "semantic_contract_refs"
      ],
      "properties": {
        "grounding_id": {
          "type": "string"
        },
        "question_revision_id": {
          "type": "string"
        },
        "source_spans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceMessageSpan"
          }
        },
        "decision_record_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "semantic_contract_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "SourceMessageSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "span_id",
        "message_id",
        "start_codepoint",
        "end_codepoint",
        "selected_text_sha256"
      ],
      "properties": {
        "span_id": {
          "type": "string"
        },
        "message_id": {
          "type": "string"
        },
        "start_codepoint": {
          "type": "integer"
        },
        "end_codepoint": {
          "type": "integer"
        },
        "selected_text_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "DecisionObjective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective_id",
        "kind",
        "requested_output_refs",
        "excluded_action_refs"
      ],
      "properties": {
        "objective_id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "understand",
            "judge",
            "choose",
            "define",
            "validate"
          ]
        },
        "requested_output_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excluded_action_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "VariableSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variable_id",
        "concept_ref",
        "data_type",
        "unit_ref",
        "role",
        "expression_contract_ref"
      ],
      "properties": {
        "variable_id": {
          "type": "string"
        },
        "concept_ref": {
          "type": "string"
        },
        "data_type": {
          "type": "string",
          "enum": [
            "money",
            "integer",
            "decimal",
            "boolean",
            "category",
            "timestamp",
            "duration"
          ]
        },
        "unit_ref": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "outcome",
            "exposure",
            "numerator",
            "denominator",
            "dimension",
            "weight",
            "covariate",
            "event_attribute"
          ]
        },
        "expression_contract_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "EventSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "event_contract_ref",
        "event_time_variable_id",
        "entity_key_variable_ids",
        "qualifying_predicate_ref"
      ],
      "properties": {
        "event_id": {
          "type": "string"
        },
        "event_contract_ref": {
          "type": "string"
        },
        "event_time_variable_id": {
          "type": "string"
        },
        "entity_key_variable_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "qualifying_predicate_ref": {
          "type": "string"
        }
      }
    },
    "PopulationSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "population_id",
        "entity_universe_ref",
        "inclusion_predicate_ref",
        "exclusion_predicate_ref",
        "sampling_frame_ref"
      ],
      "properties": {
        "population_id": {
          "type": "string"
        },
        "entity_universe_ref": {
          "type": "string"
        },
        "inclusion_predicate_ref": {
          "type": "string"
        },
        "exclusion_predicate_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "sampling_frame_ref": {
          "type": "string"
        }
      }
    },
    "ObservationUnitSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_unit_id",
        "entity_ref",
        "time_unit",
        "grain_ref",
        "dedup_identity_variable_ids"
      ],
      "properties": {
        "observation_unit_id": {
          "type": "string"
        },
        "entity_ref": {
          "type": "string"
        },
        "time_unit": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "day",
                "week",
                "month",
                "quarter",
                "year",
                "fiscal_period"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "grain_ref": {
          "type": "string"
        },
        "dedup_identity_variable_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "MetricExpression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_expression_id",
        "output_variable_id",
        "numerator_variable_ids",
        "denominator_variable_ids",
        "aggregation_order",
        "output_unit_ref"
      ],
      "properties": {
        "metric_expression_id": {
          "type": "string"
        },
        "output_variable_id": {
          "type": "string"
        },
        "numerator_variable_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "denominator_variable_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "aggregation_order": {
          "type": "string",
          "enum": [
            "sum",
            "mean",
            "ratio_of_sums",
            "mean_of_ratios",
            "weighted_mean",
            "quantile",
            "distribution",
            "accounting_identity"
          ]
        },
        "output_unit_ref": {
          "type": "string"
        }
      }
    },
    "TemporalSemanticSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "temporal_semantic_id",
        "primary_time_role",
        "time_variable_id",
        "prohibited_substitute_roles"
      ],
      "properties": {
        "temporal_semantic_id": {
          "type": "string"
        },
        "primary_time_role": {
          "type": "string",
          "enum": [
            "event_time",
            "accounting_time",
            "ingestion_time",
            "snapshot_time"
          ]
        },
        "time_variable_id": {
          "type": "string"
        },
        "prohibited_substitute_roles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "event_time",
              "accounting_time",
              "ingestion_time",
              "snapshot_time"
            ]
          }
        }
      }
    },
    "WindowRuleSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_rule_id",
        "rule_kind",
        "anchor_ref",
        "calendar_unit",
        "period_offset",
        "selection_kind",
        "selection_count",
        "ordinal_start",
        "ordinal_end",
        "absolute_start",
        "absolute_end",
        "start_boundary",
        "end_boundary",
        "pairing_key_ref",
        "selection_rationale_refs"
      ],
      "properties": {
        "window_rule_id": {
          "type": "string"
        },
        "rule_kind": {
          "type": "string",
          "enum": [
            "absolute_interval",
            "relative_calendar",
            "rolling_interval",
            "business_calendar"
          ]
        },
        "anchor_ref": {
          "type": "string"
        },
        "calendar_unit": {
          "type": "string",
          "enum": [
            "day",
            "week",
            "month",
            "quarter",
            "year",
            "fiscal_period"
          ]
        },
        "period_offset": {
          "type": "integer"
        },
        "selection_kind": {
          "type": "string",
          "enum": [
            "complete_period",
            "first_n_calendar_days",
            "last_n_calendar_days",
            "first_n_valid_business_days",
            "last_n_valid_business_days",
            "ordinal_range",
            "rolling_length"
          ]
        },
        "selection_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "ordinal_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "ordinal_end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "absolute_start": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "absolute_end": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "start_boundary": {
          "type": "string",
          "enum": [
            "inclusive",
            "exclusive"
          ]
        },
        "end_boundary": {
          "type": "string",
          "enum": [
            "inclusive",
            "exclusive"
          ]
        },
        "pairing_key_ref": {
          "type": "string"
        },
        "selection_rationale_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ExposureSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exposure_id",
        "basis",
        "unit_ref",
        "normalization",
        "aggregation_order",
        "zero_policy",
        "missing_policy",
        "minimum_coverage_ratio",
        "comparability_rule_ref"
      ],
      "properties": {
        "exposure_id": {
          "type": "string"
        },
        "basis": {
          "type": "string",
          "enum": [
            "calendar",
            "eligible",
            "observed",
            "valid",
            "missing_invalid",
            "at_risk"
          ]
        },
        "unit_ref": {
          "type": "string"
        },
        "normalization": {
          "type": "string",
          "enum": [
            "none",
            "per_exposure_unit",
            "weighted_by_exposure"
          ]
        },
        "aggregation_order": {
          "type": "string",
          "enum": [
            "sum",
            "mean",
            "ratio_of_sums",
            "mean_of_ratios",
            "weighted_mean",
            "quantile",
            "distribution",
            "accounting_identity"
          ]
        },
        "zero_policy": {
          "type": "string",
          "enum": [
            "exclude",
            "degrade",
            "block",
            "treat_as_zero"
          ]
        },
        "missing_policy": {
          "type": "string",
          "enum": [
            "exclude",
            "degrade",
            "block",
            "treat_as_zero"
          ]
        },
        "minimum_coverage_ratio": {
          "type": "string"
        },
        "comparability_rule_ref": {
          "type": "string"
        }
      }
    },
    "EstimatorSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimator_id",
        "family",
        "metric_expression_id",
        "exposure_id",
        "weight_variable_id",
        "aggregation_order",
        "uncertainty_method_ref"
      ],
      "properties": {
        "estimator_id": {
          "type": "string"
        },
        "family": {
          "type": "string",
          "enum": [
            "total",
            "mean",
            "rate",
            "ratio",
            "quantile",
            "distribution",
            "accounting_bridge",
            "association",
            "effect"
          ]
        },
        "metric_expression_id": {
          "type": "string"
        },
        "exposure_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "weight_variable_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "aggregation_order": {
          "type": "string",
          "enum": [
            "sum",
            "mean",
            "ratio_of_sums",
            "mean_of_ratios",
            "weighted_mean",
            "quantile",
            "distribution",
            "accounting_identity"
          ]
        },
        "uncertainty_method_ref": {
          "type": "string"
        }
      }
    },
    "ContrastSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contrast_id",
        "operands",
        "operator",
        "direction_from_operand_id",
        "direction_to_operand_id",
        "pairing_rule"
      ],
      "properties": {
        "contrast_id": {
          "type": "string"
        },
        "operands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContrastOperandSpec"
          }
        },
        "operator": {
          "type": "string",
          "enum": [
            "difference",
            "relative_change",
            "ratio",
            "index"
          ]
        },
        "direction_from_operand_id": {
          "type": "string"
        },
        "direction_to_operand_id": {
          "type": "string"
        },
        "pairing_rule": {
