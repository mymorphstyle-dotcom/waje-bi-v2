{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:waje-vnext:domain:context-packet:v1",
  "title": "WAJE vNext ContextPacket v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_id",
    "case_id",
    "head_version",
    "accepted_frame_revision_id",
    "accepted_plan_revision_id",
    "accepted_answer_version_id",
    "accepted_frame_payload",
    "accepted_plan_payload",
    "accepted_answer_payload",
    "user_messages",
    "relevant_event_cursor_start",
    "relevant_event_cursor_end",
    "recent_events",
    "evidence_index",
    "decision_index",
    "reviewer_objection_index",
    "built_at",
    "content_sha256"
  ],
  "properties": {
    "packet_id": {
      "$ref": "#/$defs/id"
    },
    "case_id": {
      "$ref": "#/$defs/id"
    },
    "head_version": {
      "type": "integer",
      "minimum": 0
    },
    "accepted_frame_revision_id": {
      "$ref": "#/$defs/nullableId"
    },
    "accepted_plan_revision_id": {
      "$ref": "#/$defs/nullableId"
    },
    "accepted_answer_version_id": {
      "$ref": "#/$defs/nullableId"
    },
    "accepted_frame_payload": {
      "$ref": "#/$defs/nullableObject"
    },
    "accepted_plan_payload": {
      "$ref": "#/$defs/nullableObject"
    },
    "accepted_answer_payload": {
      "$ref": "#/$defs/nullableObject"
    },
    "user_messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/contextUserMessage"
      }
    },
    "relevant_event_cursor_start": {
      "type": "integer",
      "minimum": 0
    },
    "relevant_event_cursor_end": {
      "type": "integer",
      "minimum": 0
    },
    "recent_events": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/contextEvent"
      }
    },
    "evidence_index": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/contextEvidence"
      }
    },
    "decision_index": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/contextDecision"
      }
    },
    "reviewer_objection_index": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/contextReviewerObjection"
      }
    },
    "built_at": {
      "$ref": "#/$defs/timestamp"
    },
    "content_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "nullableId": {
      "type": [
        "string",
        "null"
      ]
    },
    "nullableObject": {
      "type": [
        "object",
        "null"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "contextUserMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_id",
        "sequence",
        "authority_epoch",
        "kind",
        "content"
      ],
      "properties": {
        "message_id": {
          "$ref": "#/$defs/id"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "authority_epoch": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "$ref": "#/$defs/id"
        },
        "content": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "contextEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cursor",
        "event_type",
        "authority_ref",
        "business_projection"
      ],
      "properties": {
        "cursor": {
          "type": "integer",
          "minimum": 1
        },
        "event_type": {
          "$ref": "#/$defs/id"
        },
        "authority_ref": {
          "$ref": "#/$defs/nullableId"
        },
        "business_projection": {
          "type": "object"
        }
      }
    },
    "contextEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_record_id",
        "evidence_type",
        "strength",
        "business_summary",
        "limitation_count",
        "frame_revision_id",
        "plan_revision_id",
        "task_id",
        "snapshot_release_ref"
      ],
      "properties": {
        "evidence_record_id": {
          "$ref": "#/$defs/id"
        },
        "evidence_type": {
          "$ref": "#/$defs/id"
        },
        "strength": {
          "$ref": "#/$defs/id"
        },
        "business_summary": {
          "$ref": "#/$defs/id"
        },
        "limitation_count": {
          "type": "integer",
          "minimum": 0
        },
        "frame_revision_id": {
          "$ref": "#/$defs/id"
        },
        "plan_revision_id": {
          "$ref": "#/$defs/id"
        },
        "task_id": {
          "$ref": "#/$defs/id"
        },
        "snapshot_release_ref": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "contextDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_record_id",
        "question",
        "selected_option_id",
        "freeform_response",
        "source"
      ],
      "properties": {
        "decision_record_id": {
          "$ref": "#/$defs/id"
        },
        "question": {
          "$ref": "#/$defs/id"
        },
        "selected_option_id": {
          "$ref": "#/$defs/nullableId"
        },
        "freeform_response": {
          "$ref": "#/$defs/nullableId"
        },
        "source": {
          "$ref": "#/$defs/id"
        }
      },
      "oneOf": [
        {
          "properties": {
            "selected_option_id": {
              "$ref": "#/$defs/id"
            },
            "freeform_response": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "selected_option_id": {
              "type": "null"
            },
            "freeform_response": {
              "$ref": "#/$defs/id"
            }
          }
        }
      ]
    },
    "contextReviewerObjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objection_id",
        "objection_key",
        "revision_number",
        "answer_version_id",
        "claim_id",
        "severity",
        "status",
        "risk_type",
        "evidence_gap",
        "requested_action",
        "disposition_note"
      ],
      "properties": {
        "objection_id": {
          "$ref": "#/$defs/id"
        },
        "objection_key": {
          "$ref": "#/$defs/id"
        },
        "revision_number": {
          "type": "integer",
          "minimum": 1
        },
        "answer_version_id": {
          "$ref": "#/$defs/id"
        },
        "claim_id": {
          "$ref": "#/$defs/id"
        },
        "severity": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "$ref": "#/$defs/id"
        },
        "risk_type": {
          "$ref": "#/$defs/id"
        },
        "evidence_gap": {
          "$ref": "#/$defs/id"
        },
        "requested_action": {
          "$ref": "#/$defs/id"
        },
        "disposition_note": {
          "$ref": "#/$defs/nullableId"
        }
      }
    }
  }
}
