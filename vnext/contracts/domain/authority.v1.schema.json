{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:waje-vnext:domain:authority:v1",
  "title": "WAJE vNext authority objects v1",
  "oneOf": [
    {
      "$ref": "#/$defs/investigationCase"
    },
    {
      "$ref": "#/$defs/analysisFrameRevision"
    },
    {
      "$ref": "#/$defs/workPlanRevision"
    },
    {
      "$ref": "#/$defs/evidenceRecord"
    },
    {
      "$ref": "#/$defs/answerVersion"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "comparisonGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group_id",
        "label",
        "role",
        "membership_rule"
      ],
      "properties": {
        "group_id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "enum": [
            "focal",
            "reference"
          ]
        },
        "membership_rule": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "comparisonDesign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "groups",
        "contrast"
      ],
      "properties": {
        "mode": {
          "enum": [
            "absolute",
            "between_groups",
            "within_unit",
            "counterfactual"
          ]
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/comparisonGroup"
          }
        },
        "contrast": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "exposureDesign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variable",
        "unit",
        "balance_assumption",
        "sensitivity_adjustments",
        "normalization_strategy",
        "diagnostic_requirement_id",
        "sensitivity_requirement_id"
      ],
      "properties": {
        "variable": {
          "$ref": "#/$defs/id"
        },
        "unit": {
          "$ref": "#/$defs/id"
        },
        "balance_assumption": {
          "enum": [
            "unknown",
            "expected_equal",
            "expected_unequal"
          ]
        },
        "sensitivity_adjustments": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "none",
              "per_exposure_unit",
              "model_adjusted",
              "stratified",
              "design_equalized",
              "other"
            ]
          }
        },
        "normalization_strategy": {
          "$ref": "#/$defs/id"
        },
        "diagnostic_requirement_id": {
          "$ref": "#/$defs/id"
        },
        "sensitivity_requirement_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "estimatorSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quantity",
        "aggregation",
        "numerator",
        "denominator",
        "exposure_adjustment"
      ],
      "properties": {
        "quantity": {
          "$ref": "#/$defs/id"
        },
        "aggregation": {
          "enum": [
            "sum",
            "mean",
            "ratio",
            "rate",
            "difference",
            "model_based",
            "other"
          ]
        },
        "numerator": {
          "$ref": "#/$defs/id"
        },
        "denominator": {
          "$ref": "#/$defs/id"
        },
        "exposure_adjustment": {
          "enum": [
            "none",
            "per_exposure_unit",
            "model_adjusted",
            "stratified",
            "design_equalized",
            "other"
          ]
        }
      }
    },
    "frameRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "kind",
        "question",
        "success_condition",
        "failure_consequence"
      ],
      "properties": {
        "requirement_id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "semantic",
            "coverage",
            "exposure",
            "sensitivity",
            "alternative",
            "falsification"
          ]
        },
        "question": {
          "$ref": "#/$defs/id"
        },
        "success_condition": {
          "$ref": "#/$defs/id"
        },
        "failure_consequence": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "alternativeHypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alternative_id",
        "statement",
        "requirement_id"
      ],
      "properties": {
        "alternative_id": {
          "$ref": "#/$defs/id"
        },
        "statement": {
          "$ref": "#/$defs/id"
        },
        "requirement_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "investigationCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "thread_id",
        "lifecycle",
        "head_version",
        "accepted_frame_revision_id",
        "accepted_plan_revision_id",
        "accepted_answer_version_id",
        "opened_at",
        "updated_at"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/id"
        },
        "thread_id": {
          "$ref": "#/$defs/id"
        },
        "lifecycle": {
          "enum": [
            "open",
            "waiting_for_user",
            "stopped",
            "closed"
          ]
        },
        "head_version": {
          "type": "integer",
          "minimum": 0
        },
        "accepted_frame_revision_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "accepted_plan_revision_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "accepted_answer_version_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "opened_at": {
          "$ref": "#/$defs/timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "analysisFrameRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_revision_id",
        "case_id",
        "revision_number",
        "prior_frame_revision_id",
        "created_by_action_id",
        "created_at",
        "revision_reason",
        "estimand",
        "population",
        "time_scope",
        "observation_unit",
        "primary_estimator",
        "exposure",
        "comparison",
        "measurement_rationale",
        "assumptions",
        "alternatives",
        "requirements",
        "falsification_conditions",
        "reversal_conditions",
        "success_conditions",
        "stop_conditions",
        "decision_record_ids",
        "semantic_contract_refs"
      ],
      "properties": {
        "frame_revision_id": {
          "$ref": "#/$defs/id"
        },
        "case_id": {
          "$ref": "#/$defs/id"
        },
        "revision_number": {
          "type": "integer",
          "minimum": 1
        },
        "prior_frame_revision_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_by_action_id": {
          "$ref": "#/$defs/id"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "revision_reason": {
          "$ref": "#/$defs/id"
        },
        "estimand": {
          "$ref": "#/$defs/id"
        },
        "population": {
          "$ref": "#/$defs/id"
        },
        "time_scope": {
          "$ref": "#/$defs/id"
        },
        "observation_unit": {
          "$ref": "#/$defs/id"
        },
        "primary_estimator": {
          "$ref": "#/$defs/estimatorSpec"
        },
        "exposure": {
          "$ref": "#/$defs/exposureDesign"
        },
        "comparison": {
          "$ref": "#/$defs/comparisonDesign"
        },
        "measurement_rationale": {
          "$ref": "#/$defs/id"
        },
        "assumptions": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "alternatives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/alternativeHypothesis"
          }
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/frameRequirement"
          }
        },
        "falsification_conditions": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "reversal_conditions": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "success_conditions": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "stop_conditions": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "decision_record_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "semantic_contract_refs": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "workTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "business_purpose",
        "capability_intent",
        "target_claim_ids",
        "requirement_ids",
        "depends_on_task_ids",
        "success_conditions",
        "stop_conditions"
      ],
      "properties": {
        "task_id": {
          "$ref": "#/$defs/id"
        },
        "business_purpose": {
          "$ref": "#/$defs/id"
        },
        "capability_intent": {
          "$ref": "#/$defs/id"
        },
        "target_claim_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "requirement_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "depends_on_task_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "success_conditions": {
          "$ref": "#/$defs/stringArray"
        },
        "stop_conditions": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "workPlanRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_revision_id",
        "case_id",
        "frame_revision_id",
        "revision_number",
        "prior_plan_revision_id",
        "created_by_action_id",
        "created_at",
        "revision_reason",
        "tasks"
      ],
      "properties": {
        "plan_revision_id": {
          "$ref": "#/$defs/id"
        },
        "case_id": {
          "$ref": "#/$defs/id"
        },
        "frame_revision_id": {
          "$ref": "#/$defs/id"
        },
        "revision_number": {
          "type": "integer",
          "minimum": 1
        },
        "prior_plan_revision_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_by_action_id": {
          "$ref": "#/$defs/id"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "revision_reason": {
          "$ref": "#/$defs/id"
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/workTask"
          }
        }
      }
    },
    "resultHandle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handle_id",
        "content_sha256",
        "schema_ref",
        "row_count",
        "storage_ref"
      ],
      "properties": {
        "handle_id": {
          "$ref": "#/$defs/id"
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "schema_ref": {
          "$ref": "#/$defs/id"
        },
        "row_count": {
          "type": "integer",
          "minimum": 0
        },
        "storage_ref": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "evidenceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_record_id",
        "case_id",
        "frame_revision_id",
        "plan_revision_id",
        "task_id",
        "capability_name",
        "query_spec_ref",
        "semantic_contract_refs",
        "snapshot_release_ref",
        "grain",
        "evidence_type",
        "strength",
        "business_summary",
        "limitations",
        "provenance",
        "payload_sha256",
        "inline_payload",
        "result_handle",
        "created_at"
      ],
      "properties": {
        "evidence_record_id": {
          "$ref": "#/$defs/id"
        },
        "case_id": {
          "$ref": "#/$defs/id"
        },
        "frame_revision_id": {
          "$ref": "#/$defs/id"
        },
        "plan_revision_id": {
          "$ref": "#/$defs/id"
        },
        "task_id": {
          "$ref": "#/$defs/id"
        },
        "capability_name": {
          "$ref": "#/$defs/id"
        },
        "query_spec_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "semantic_contract_refs": {
          "$ref": "#/$defs/stringArray"
        },
        "snapshot_release_ref": {
          "$ref": "#/$defs/id"
        },
        "grain": {
          "$ref": "#/$defs/id"
        },
        "evidence_type": {
          "enum": [
            "accounting",
            "descriptive",
            "association",
            "candidate_mechanism",
            "causal",
            "data_quality",
            "boundary"
          ]
        },
        "strength": {
          "enum": [
            "none",
            "contextual",
            "directional",
            "quantified",
            "causal"
          ]
        },
        "business_summary": {
          "$ref": "#/$defs/id"
        },
        "limitations": {
          "$ref": "#/$defs/stringArray"
        },
        "provenance": {
          "type": "object"
        },
        "payload_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "inline_payload": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "result_handle": {
          "anyOf": [
            {
              "$ref": "#/$defs/resultHandle"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "oneOf": [
        {
          "properties": {
            "inline_payload": {
              "type": "object"
            },
            "result_handle": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "inline_payload": {
              "type": "null"
            },
            "result_handle": {
              "$ref": "#/$defs/resultHandle"
            }
          }
        }
      ]
    },
    "answerClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "statement",
        "applicability",
        "evidence_record_ids",
        "boundary_ref",
        "limitations",
        "verifier_status",
        "reviewer_objection_ids"
      ],
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/id"
        },
        "statement": {
          "$ref": "#/$defs/id"
        },
        "applicability": {
          "$ref": "#/$defs/id"
        },
        "evidence_record_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "boundary_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "limitations": {
          "$ref": "#/$defs/stringArray"
        },
        "verifier_status": {
          "enum": [
            "pending",
            "accepted",
            "boundary_only",
            "rejected"
          ]
        },
        "reviewer_objection_ids": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "answerVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answer_version_id",
        "case_id",
        "frame_revision_id",
        "plan_revision_id",
        "version_number",
        "prior_answer_version_id",
        "status",
        "claims",
        "narrative_markdown",
        "verifier_policy_version",
        "unresolved_blocking_objection_ids",
        "settlement_fingerprint",
        "created_by_action_id",
        "created_at"
      ],
      "properties": {
        "answer_version_id": {
          "$ref": "#/$defs/id"
        },
        "case_id": {
          "$ref": "#/$defs/id"
        },
        "frame_revision_id": {
          "$ref": "#/$defs/id"
        },
        "plan_revision_id": {
          "$ref": "#/$defs/id"
        },
        "version_number": {
          "type": "integer",
          "minimum": 1
        },
        "prior_answer_version_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "provisional",
            "settled"
          ]
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/answerClaim"
          }
        },
        "narrative_markdown": {
          "$ref": "#/$defs/id"
        },
        "verifier_policy_version": {
          "$ref": "#/$defs/id"
        },
        "unresolved_blocking_objection_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "settlement_fingerprint": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_by_action_id": {
          "$ref": "#/$defs/id"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    }
  }
}
