{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:waje-vnext:domain:authority:v1",
  "title": "WAJE vNext authority objects v1",
  "oneOf": [
    {
      "$ref": "#/$defs/investigationCase"
    },
    {
      "$ref": "#/$defs/analysisFrameRevision"
    },
    {
      "$ref": "#/$defs/workPlanRevision"
    },
    {
      "$ref": "#/$defs/evidenceRecord"
    },
    {
      "$ref": "#/$defs/answerVersion"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "investigationCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "thread_id",
        "lifecycle",
        "head_version",
        "accepted_frame_revision_id",
        "accepted_plan_revision_id",
        "accepted_answer_version_id",
        "opened_at",
        "updated_at"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/id"
        },
        "thread_id": {
          "$ref": "#/$defs/id"
        },
        "lifecycle": {
          "enum": [
            "open",
            "waiting_for_user",
            "stopped",
            "closed"
          ]
        },
        "head_version": {
          "type": "integer",
          "minimum": 0
        },
        "accepted_frame_revision_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "accepted_plan_revision_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "accepted_answer_version_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "opened_at": {
          "$ref": "#/$defs/timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "analysisFrameRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_revision_id",
        "case_id",
        "revision_number",
        "prior_frame_revision_id",
        "created_by_action_id",
        "created_at",
        "revision_reason",
        "estimand",
        "observation_unit",
        "numerator",
        "denominator",
        "exposure",
        "comparison",
        "assumptions",
        "alternatives",
        "falsification_conditions",
        "reversal_conditions",
        "success_conditions",
        "stop_conditions",
        "decision_record_ids",
        "semantic_contract_refs"
      ],
      "properties": {
        "frame_revision_id": {
          "$ref": "#/$defs/id"
        },
        "case_id": {
          "$ref": "#/$defs/id"
        },
        "revision_number": {
          "type": "integer",
          "minimum": 1
        },
        "prior_frame_revision_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_by_action_id": {
          "$ref": "#/$defs/id"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "revision_reason": {
          "$ref": "#/$defs/id"
        },
        "estimand": {
          "$ref": "#/$defs/id"
        },
        "observation_unit": {
          "$ref": "#/$defs/id"
        },
        "numerator": {
          "$ref": "#/$defs/id"
        },
        "denominator": {
          "$ref": "#/$defs/id"
        },
        "exposure": {
          "$ref": "#/$defs/id"
        },
        "comparison": {
          "$ref": "#/$defs/id"
        },
        "assumptions": {
          "$ref": "#/$defs/stringArray"
        },
        "alternatives": {
          "$ref": "#/$defs/stringArray"
        },
        "falsification_conditions": {
          "$ref": "#/$defs/stringArray"
        },
        "reversal_conditions": {
          "$ref": "#/$defs/stringArray"
        },
        "success_conditions": {
          "$ref": "#/$defs/stringArray"
        },
        "stop_conditions": {
          "$ref": "#/$defs/stringArray"
        },
        "decision_record_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "semantic_contract_refs": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "workTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "business_purpose",
        "capability_intent",
        "target_claim_ids",
        "depends_on_task_ids",
        "success_conditions",
        "stop_conditions"
      ],
      "properties": {
        "task_id": {
          "$ref": "#/$defs/id"
        },
        "business_purpose": {
          "$ref": "#/$defs/id"
        },
        "capability_intent": {
          "$ref": "#/$defs/id"
        },
        "target_claim_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "depends_on_task_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "success_conditions": {
          "$ref": "#/$defs/stringArray"
        },
        "stop_conditions": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "workPlanRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_revision_id",
        "case_id",
        "frame_revision_id",
        "revision_number",
        "prior_plan_revision_id",
        "created_by_action_id",
        "created_at",
        "revision_reason",
        "tasks"
      ],
      "properties": {
        "plan_revision_id": {
          "$ref": "#/$defs/id"
        },
        "case_id": {
          "$ref": "#/$defs/id"
        },
        "frame_revision_id": {
          "$ref": "#/$defs/id"
        },
        "revision_number": {
          "type": "integer",
          "minimum": 1
        },
        "prior_plan_revision_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_by_action_id": {
          "$ref": "#/$defs/id"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "revision_reason": {
          "$ref": "#/$defs/id"
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/workTask"
          }
        }
      }
    },
    "resultHandle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handle_id",
        "content_sha256",
        "schema_ref",
        "row_count",
        "storage_ref"
      ],
      "properties": {
        "handle_id": {
          "$ref": "#/$defs/id"
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "schema_ref": {
          "$ref": "#/$defs/id"
        },
        "row_count": {
          "type": "integer",
          "minimum": 0
        },
        "storage_ref": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "evidenceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_record_id",
        "case_id",
        "frame_revision_id",
        "plan_revision_id",
        "task_id",
        "capability_name",
        "query_spec_ref",
        "semantic_contract_refs",
        "snapshot_release_ref",
        "grain",
        "evidence_type",
        "strength",
        "business_summary",
        "limitations",
        "provenance",
        "payload_sha256",
        "inline_payload",
        "result_handle",
        "created_at"
      ],
      "properties": {
        "evidence_record_id": {
          "$ref": "#/$defs/id"
        },
        "case_id": {
          "$ref": "#/$defs/id"
        },
        "frame_revision_id": {
          "$ref": "#/$defs/id"
        },
        "plan_revision_id": {
          "$ref": "#/$defs/id"
        },
        "task_id": {
          "$ref": "#/$defs/id"
        },
        "capability_name": {
          "$ref": "#/$defs/id"
        },
        "query_spec_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "semantic_contract_refs": {
          "$ref": "#/$defs/stringArray"
        },
        "snapshot_release_ref": {
          "$ref": "#/$defs/id"
        },
        "grain": {
          "$ref": "#/$defs/id"
        },
        "evidence_type": {
          "enum": [
            "accounting",
            "descriptive",
            "association",
            "candidate_mechanism",
            "causal",
            "data_quality",
            "boundary"
          ]
        },
        "strength": {
          "enum": [
            "none",
            "contextual",
            "directional",
            "quantified",
            "causal"
          ]
        },
        "business_summary": {
          "$ref": "#/$defs/id"
        },
        "limitations": {
          "$ref": "#/$defs/stringArray"
        },
        "provenance": {
          "type": "object"
        },
        "payload_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "inline_payload": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "result_handle": {
          "anyOf": [
            {
              "$ref": "#/$defs/resultHandle"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "oneOf": [
        {
          "properties": {
            "inline_payload": {
              "type": "object"
            },
            "result_handle": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "inline_payload": {
              "type": "null"
            },
            "result_handle": {
              "$ref": "#/$defs/resultHandle"
            }
          }
        }
      ]
    },
    "answerClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "statement",
        "applicability",
        "evidence_record_ids",
        "boundary_ref",
        "limitations",
        "verifier_status",
        "reviewer_objection_ids"
      ],
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/id"
        },
        "statement": {
          "$ref": "#/$defs/id"
        },
        "applicability": {
          "$ref": "#/$defs/id"
        },
        "evidence_record_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "boundary_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "limitations": {
          "$ref": "#/$defs/stringArray"
        },
        "verifier_status": {
          "enum": [
            "accepted",
            "boundary_only",
            "rejected"
          ]
        },
        "reviewer_objection_ids": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "answerVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answer_version_id",
        "case_id",
        "frame_revision_id",
        "plan_revision_id",
        "version_number",
        "prior_answer_version_id",
        "status",
        "claims",
        "narrative_markdown",
        "verifier_policy_version",
        "unresolved_blocking_objection_ids",
        "settlement_fingerprint",
        "created_by_action_id",
        "created_at"
      ],
      "properties": {
        "answer_version_id": {
          "$ref": "#/$defs/id"
        },
        "case_id": {
          "$ref": "#/$defs/id"
        },
        "frame_revision_id": {
          "$ref": "#/$defs/id"
        },
        "plan_revision_id": {
          "$ref": "#/$defs/id"
        },
        "version_number": {
          "type": "integer",
          "minimum": 1
        },
        "prior_answer_version_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "provisional",
            "settled"
          ]
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/answerClaim"
          }
        },
        "narrative_markdown": {
          "$ref": "#/$defs/id"
        },
        "verifier_policy_version": {
          "$ref": "#/$defs/id"
        },
        "unresolved_blocking_objection_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "settlement_fingerprint": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_by_action_id": {
          "$ref": "#/$defs/id"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    }
  }
}
