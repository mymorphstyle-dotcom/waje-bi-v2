{
  "name": "waje-bi-agent-vnext",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "bootstrap": "uv sync --frozen --no-install-project --python 3.12.13",
    "check": ".venv/bin/python tools/verify_isolation.py",
    "generate:eval-ledger:gate3": ".venv/bin/python tools/validate_gate3_eval_catalog.py evals/gate3/catalog/gate3-authoring-candidates.json --report evals/gate3/coverage-ledger.json",
    "check:evals:gate3": ".venv/bin/python tools/validate_gate3_eval_catalog.py evals/gate3/catalog/gate3-authoring-candidates.json --check-report evals/gate3/coverage-ledger.json",
    "check:evals:gate3:policy-ready": ".venv/bin/python tools/validate_gate3_eval_catalog.py evals/gate3/catalog/gate3-authoring-candidates.json --require-policy-ready",
    "generate:contracts": "node tools/generate-contract-bindings.mjs",
    "check:contracts": "node tools/generate-contract-bindings.mjs --check",
    "test:bootstrap": "PYTHONPATH=services/analysis_core/src .venv/bin/python -m unittest discover -s tests -p 'test_*.py'",
    "test:postgres": ".venv/bin/python tools/run_gate1_postgres_acceptance.py",
    "test:postgres:gate2": ".venv/bin/python tools/run_gate2_postgres_acceptance.py",
    "test:provider:gate2": "PYTHONPATH=services/analysis_core/src .venv/bin/python tools/run_gate2_provider_acceptance.py",
    "run:bootstrap": "PYTHONPATH=services/analysis_core/src .venv/bin/python -m waje_vnext health"
  },
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "devDependencies": {
    "json-schema-to-typescript": "15.0.4"
  }
}
