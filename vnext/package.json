{
  "name": "waje-bi-agent-vnext",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "bootstrap": "uv sync --frozen --no-install-project --python 3.12.13",
    "check": ".venv/bin/python tools/verify_isolation.py",
    "generate:eval-corpus:gate3": ".venv/bin/python tools/build_gate3_eval_corpus.py --write",
    "check:eval-corpus:gate3": ".venv/bin/python tools/build_gate3_eval_corpus.py --check",
    "generate:eval-ledger:gate3": ".venv/bin/python tools/validate_gate3_eval_catalog.py evals/gate3/catalog/gate3-authoring-candidates.json --report evals/gate3/coverage-ledger.json",
    "generate:eval-readiness:gate3": ".venv/bin/python tools/verify_gate3_e0.py --write-manifest",
    "check:eval-views:gate3": ".venv/bin/python tools/compile_gate3_eval_views.py --check",
    "generate:eval-execution-universe:gate3": ".venv/bin/python tools/compile_gate3_execution_universe.py --write",
    "check:eval-execution-universe:gate3": ".venv/bin/python tools/compile_gate3_execution_universe.py --check",
    "gate3:require-full-execution-universe": ".venv/bin/python tools/compile_gate3_execution_universe.py --check --require-development-ready",
    "check:eval-execution:gate3": "PYTHONPATH=services/analysis_core/src:tests:. .venv/bin/python -m unittest tests.test_gate3_6_execution_authority tests.test_gate3_execution_universe",
    "check:evals:gate3": ".venv/bin/python tools/verify_gate3_e0.py --check",
    "check:evals:gate3:policy-ready": ".venv/bin/python tools/verify_gate3_e0.py --check --require-ready",
    "gate3:enter:g3.1": ".venv/bin/python tools/assert_gate3_1_entry.py",
    "check:github-deployment": ".venv/bin/python tools/verify_github_workflow_deployment.py",
    "generate:contract-schemas": "PYTHONPATH=services/analysis_core/src .venv/bin/python tools/generate_python_contract_schemas.py",
    "check:contract-schemas": "PYTHONPATH=services/analysis_core/src .venv/bin/python tools/generate_python_contract_schemas.py --check",
    "check:measurement-identity": "node tools/verify-measurement-identity-vectors.mjs",
    "generate:contracts": "npm run generate:contract-schemas && node tools/generate-contract-bindings.mjs",
    "check:contracts": "npm run check:contract-schemas && node tools/generate-contract-bindings.mjs --check && npm run check:measurement-identity",
    "test:bootstrap": "PYTHONPATH=services/analysis_core/src .venv/bin/python -m unittest discover -s tests -p 'test_*.py'",
    "test:postgres": ".venv/bin/python tools/run_gate1_postgres_acceptance.py",
    "test:postgres:gate2": ".venv/bin/python tools/run_gate2_postgres_acceptance.py",
    "test:postgres:gate3.4": ".venv/bin/python tools/run_gate3_4_postgres_acceptance.py",
    "test:postgres:gate3.5": ".venv/bin/python tools/run_gate3_5_migration_acceptance.py",
    "test:provider:gate2": "PYTHONPATH=services/analysis_core/src .venv/bin/python tools/run_gate2_provider_acceptance.py",
    "run:bootstrap": "PYTHONPATH=services/analysis_core/src .venv/bin/python -m waje_vnext health"
  },
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "devDependencies": {
    "json-schema-to-typescript": "15.0.4"
  }
}
