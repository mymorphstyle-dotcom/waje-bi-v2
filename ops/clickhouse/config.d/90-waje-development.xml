<clickhouse>
    <!-- Local development keeps enough headroom for observed 41M-row queries. -->
    <max_connections>512</max_connections>
    <max_concurrent_queries>32</max_concurrent_queries>
    <max_server_memory_usage>17179869184</max_server_memory_usage>

    <!-- Bound idle thread retention and background concurrency on macOS Docker. -->
    <max_thread_pool_size>2048</max_thread_pool_size>
    <max_thread_pool_free_size>128</max_thread_pool_free_size>
    <max_io_thread_pool_size>32</max_io_thread_pool_size>
    <max_io_thread_pool_free_size>16</max_io_thread_pool_free_size>
    <max_backups_io_thread_pool_size>16</max_backups_io_thread_pool_size>
    <max_backups_io_thread_pool_free_size>4</max_backups_io_thread_pool_free_size>
    <background_buffer_flush_schedule_pool_size>8</background_buffer_flush_schedule_pool_size>
    <background_pool_size>8</background_pool_size>
    <background_move_pool_size>4</background_move_pool_size>
    <background_fetches_pool_size>4</background_fetches_pool_size>
    <background_common_pool_size>4</background_common_pool_size>
    <background_schedule_pool_size>64</background_schedule_pool_size>
    <background_message_broker_schedule_pool_size>4</background_message_broker_schedule_pool_size>
    <background_distributed_schedule_pool_size>4</background_distributed_schedule_pool_size>
    <max_active_parts_loading_thread_pool_size>16</max_active_parts_loading_thread_pool_size>
    <max_outdated_parts_loading_thread_pool_size>8</max_outdated_parts_loading_thread_pool_size>
    <max_unexpected_parts_loading_thread_pool_size>4</max_unexpected_parts_loading_thread_pool_size>
    <max_parts_cleaning_thread_pool_size>16</max_parts_cleaning_thread_pool_size>
    <tables_loader_foreground_pool_size>8</tables_loader_foreground_pool_size>
    <tables_loader_background_pool_size>8</tables_loader_background_pool_size>

    <merge_tree>
        <number_of_free_entries_in_pool_to_lower_max_size_of_merge>4</number_of_free_entries_in_pool_to_lower_max_size_of_merge>
        <number_of_free_entries_in_pool_to_execute_mutation>8</number_of_free_entries_in_pool_to_execute_mutation>
        <number_of_free_entries_in_pool_to_execute_optimize_entire_partition>12</number_of_free_entries_in_pool_to_execute_optimize_entire_partition>
    </merge_tree>

    <total_memory_profiler_step>0</total_memory_profiler_step>
    <total_memory_tracker_sample_probability>0</total_memory_tracker_sample_probability>

    <logger>
        <level>warning</level>
        <console_log_level>warning</console_log_level>
    </logger>

    <!-- SQL/error/part diagnostics stay available with bounded retention. -->
    <query_log replace="replace">
        <database>system</database>
        <table>query_log</table>
        <partition_by>toYYYYMM(event_date)</partition_by>
        <ttl>event_date + INTERVAL 14 DAY DELETE</ttl>
        <flush_interval_milliseconds>30000</flush_interval_milliseconds>
        <max_size_rows>262144</max_size_rows>
        <reserved_size_rows>4096</reserved_size_rows>
        <buffer_size_rows_flush_threshold>131072</buffer_size_rows_flush_threshold>
        <flush_on_crash>false</flush_on_crash>
    </query_log>

    <part_log replace="replace">
        <database>system</database>
        <table>part_log</table>
        <partition_by>toYYYYMM(event_date)</partition_by>
        <ttl>event_date + INTERVAL 14 DAY DELETE</ttl>
        <flush_interval_milliseconds>30000</flush_interval_milliseconds>
        <max_size_rows>262144</max_size_rows>
        <reserved_size_rows>4096</reserved_size_rows>
        <buffer_size_rows_flush_threshold>131072</buffer_size_rows_flush_threshold>
        <flush_on_crash>false</flush_on_crash>
    </part_log>

    <text_log replace="replace">
        <database>system</database>
        <table>text_log</table>
        <partition_by>toYYYYMM(event_date)</partition_by>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
        <flush_interval_milliseconds>30000</flush_interval_milliseconds>
        <max_size_rows>262144</max_size_rows>
        <reserved_size_rows>4096</reserved_size_rows>
        <buffer_size_rows_flush_threshold>131072</buffer_size_rows_flush_threshold>
        <flush_on_crash>false</flush_on_crash>
        <level>warning</level>
    </text_log>

    <error_log replace="replace">
        <database>system</database>
        <table>error_log</table>
        <partition_by>toYYYYMM(event_date)</partition_by>
        <ttl>event_date + INTERVAL 30 DAY DELETE</ttl>
        <flush_interval_milliseconds>30000</flush_interval_milliseconds>
        <max_size_rows>65536</max_size_rows>
        <reserved_size_rows>1024</reserved_size_rows>
        <buffer_size_rows_flush_threshold>32768</buffer_size_rows_flush_threshold>
        <collect_interval_milliseconds>5000</collect_interval_milliseconds>
        <flush_on_crash>false</flush_on_crash>
    </error_log>

    <!-- Live system.metrics remain queryable; these persistent samplers are off. -->
    <trace_log remove="remove"/>
    <metric_log remove="remove"/>
    <asynchronous_metric_log remove="remove"/>
    <processors_profile_log remove="remove"/>
</clickhouse>
